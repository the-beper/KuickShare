FROM registry.fedoraproject.org/fedora:45

RUN dnf install -y --setopt=install_weak_deps=False \
        gcc gcc-c++ make cmake ninja-build pkgconf-pkg-config git \
        dbus-devel dbus-daemon protobuf-compiler squashfs-tools curl \
        libxml2 desktop-file-utils appstream gettext \
        qt6-qtbase-devel qt6-qtdeclarative-devel qt6-qtsvg-devel \
        extra-cmake-modules \
        kf6-kirigami-devel kf6-kstatusnotifieritem-devel kf6-knotifications-devel \
        kf6-ki18n-devel kf6-kconfig-devel kf6-kcoreaddons-devel kf6-kcrash-devel kf6-kdbusaddons-devel \
        kf6-kio-devel kf6-kiconthemes-devel kf6-kirigami-addons \
    && dnf clean all

# Links the ghcr.io package to the repository, so the workflows can pull it with GITHUB_TOKEN.
LABEL org.opencontainers.image.source="https://github.com/the-beper/KuickShare"
