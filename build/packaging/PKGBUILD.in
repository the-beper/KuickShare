# Rendered by build/packaging/render.sh (@VERSION@, @SHA256@): edit the template, never this file.
# pkgver must match the tag: check-version.sh compares src/shell/CMakeLists.txt, this recipe carries no
# version to bump by hand. Source is the checksum-pinned tarball made by source-tarball.sh; the AUR
# package in phase 6 is this file with source=(https://github.com/…/KuickShare/releases/…).
pkgname=kuickshare
pkgver=@VERSION@
pkgrel=1
pkgdesc="Share files between devices on the same network"
url="https://github.com/the-beper/KuickShare"
license=(GPL-3.0-or-later)
arch=(x86_64)
# Release package, not the AUR one: no -debug subpackage (the binaries get stripped; the tests and
# the checks build with symbols anyway).
options=(!debug)
depends=(dbus kirigami ki18n kcoreaddons kcrash kdbusaddons kjobwidgets knotifications
         kstatusnotifieritem qqc2-desktop-style kirigami-addons qt6-base qt6-declarative qt6-svg)
makedepends=(cmake ninja pkgconf protobuf rust)
source=("@TARBALL@")
sha256sums=('@SHA256@')

# The Rust and C++ tests run in the normal checks (check.sh), not here. Makepkg compiles with the
# system cargo against Cargo.lock. Both sections run with cwd = $srcdir (the extracted tree is a folder
# in it): cd in first, or a "src/shell" -S would double up and cargo could even resolve a workspace
# up the tree - the tarball always builds from its own root.
build() {
    cd "$pkgname-$pkgver"
    cargo build --release --locked
    cmake -S src/shell -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF \
        -DKUICKSHARED_PATH="$PWD/target/release/kuickshared"
    cmake --build build
}

package() {
    cd "$pkgname-$pkgver"
    DESTDIR="$pkgdir" cmake --install build --prefix /usr --strip
}
