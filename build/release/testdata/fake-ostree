#!/usr/bin/env python3
"""A stand-in for the ostree CLI, for build/release/simulate.sh: a repository is a directory with
refs/heads/<ref> (a file holding a commit id) and objects/<first two digits>/<rest>.commit ("parent=<id or ->" and a
body). It implements the calls the release scripts make, plus `fake-commit`, which plays what flatpak-builder does when it
exports a build. `gpg-sign` writes <rest>.commitmeta, a detached GnuPG signature of the commit, and refuses a commit that
has one, as ostree does; `remote add` and `pull` check commit signatures with the key imported into the remote;
`show --print-detached-metadata-key=ostree.gpgsigs` prints something only for a signed commit; `fsck` only checks that
every ref names a commit that exists. The id of a commit is the SHA-256 of its file. A commit file has the lines `parent=<id or ->`, the body and `binding=<ref>`, what
`show --print-metadata-key=ostree.ref-binding` prints (as `['<ref>']`); `init` writes the config of an archive-z2 repository.
Optional lines after those: `date=<seconds>` (default: now, or $FAKE_OSTREE_DATE for fake-commit), `keys=<metadata keys>`
(`show --list-metadata-keys`, default the two bindings), `subject=` (default the body) and `message=` (a body); `version=` (what `cat` prints
as the first release of the metainfo) and `collection=` (the value of ostree.collection-binding, default empty); `show` prints
the header with the date, then the subject and the message, and for a signed commit the lines about its signature, as ostree does.
"""
import hashlib
import os
import re
import shutil
import subprocess
import sys
import time

LOG = os.environ.get("FAKE_OSTREE_LOG")


def die(message, code=1):
    print("fake-ostree: " + message, file=sys.stderr)
    sys.exit(code)


def log(line):
    if LOG:
        with open(LOG, "a") as f:
            f.write(line + "\n")


def commit_path(repo, commit, ext=".commit"):
    """Where ostree keeps an object of an archive repository: objects/<first two digits>/<the rest><ext>."""
    return os.path.join(repo, "objects", commit[:2], commit[2:] + ext)


def read_ref(repo, ref):
    path = os.path.join(repo, "refs", "heads", ref)
    if os.path.isfile(path):
        with open(path) as f:
            return f.read().strip()
    if os.path.isfile(commit_path(repo, ref)):
        return ref
    die("rev-parse: %s not found" % ref)


def commit_lines(repo, commit):
    """The optional lines of a commit file (the second line is the body and can hold anything)."""
    found = {}
    with open(commit_path(repo, commit)) as f:
        for number, line in enumerate(f):
            for name in ("date", "keys", "subject", "message", "version", "collection"):
                if number != 1 and line.startswith(name + "="):
                    found[name] = line.rstrip("\n").split("=", 1)[1]
    return found


def parent_of(repo, commit):
    with open(commit_path(repo, commit)) as f:
        first = f.readline().strip()
    return first.split("=", 1)[1]


def write_config(repo):
    os.makedirs(repo, exist_ok=True)
    with open(os.path.join(repo, "config"), "w") as f:
        f.write("[core]\nrepo_version=1\nmode=archive-z2\n")


def write_ref(repo, ref, commit):
    path = os.path.join(repo, "refs", "heads", ref)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        f.write(commit + "\n")


def main():
    args = sys.argv[1:]
    repo = None
    rest = []
    i = 0
    while i < len(args):
        if args[i].startswith("--repo="):
            repo = args[i].split("=", 1)[1]
        elif args[i] == "--repo":
            i += 1
            repo = args[i]
        else:
            rest.append(args[i])
        i += 1
    if not rest:
        die("no command", 99)
    command, rest = rest[0], rest[1:]
    log(command + " " + " ".join(rest))
    if os.environ.get("GH_TOKEN"):
        log("SAW GH_TOKEN in the environment of " + command)

    if command == "init":
        os.makedirs(os.path.join(repo, "refs", "heads"), exist_ok=True)
        os.makedirs(os.path.join(repo, "objects"), exist_ok=True)
        write_config(repo)
    elif command == "refs":
        create = [r for r in rest if r.startswith("--create=")]
        if create:
            # Like ostree: a new ref for an existing commit; an existing ref is an error.
            ref = create[0].split("=", 1)[1]
            commit = [r for r in rest if not r.startswith("--")][0]
            if not os.path.isfile(commit_path(repo, commit)):
                die("refs: no commit %s" % commit)
            if os.path.isfile(os.path.join(repo, "refs", "heads", ref)):
                die("refs: %s already exists" % ref)
            write_ref(repo, ref, commit)
            return
        base = os.path.join(repo, "refs", "heads")
        for root, _, files in os.walk(base):
            for name in sorted(files):
                print(os.path.relpath(os.path.join(root, name), base))
    elif command == "rev-parse":
        spec = rest[0]
        if spec.endswith("^"):
            commit = read_ref(repo, spec[:-1])
            parent = parent_of(repo, commit)
            if parent == "-":
                die("rev-parse: %s has no parent" % commit)
            print(parent)
        else:
            print(read_ref(repo, spec))
    elif command == "pull-local":
        rest = [r for r in rest if not r.startswith("--")]
        src, refs = rest[0], rest[1:]
        for ref in refs:
            # Like ostree: a ref name is copied with its ref, a bare checksum only as objects.
            named = os.path.isfile(os.path.join(src, "refs", "heads", ref))
            commit = read_ref(src, ref)
            for suffix in (".commit", ".commitmeta"):
                path = commit_path(src, commit, suffix)
                if os.path.exists(path):
                    os.makedirs(os.path.dirname(commit_path(repo, commit)), exist_ok=True)
                    shutil.copy(path, commit_path(repo, commit, suffix))
            if named:
                write_ref(repo, ref, commit)
    elif command == "remote":
        # remote add [--set=k=v] [--gpg-import=FILE] NAME URL: the URL and a keyring of its own under the repository
        if rest[0] == "summary":
            # remote summary NAME: the refs of the remote's summary file, in the format of ostree
            with open(os.path.join(repo, "remote-" + rest[1])) as f:
                src = f.read().strip()[len("file://"):]
            with open(os.path.join(src, "summary")) as f:
                for line in f:
                    ref, commit = line.split()
                    print("* %s\n    Latest Commit (0 bytes):\n      %s\n" % (ref, commit))
            return
        if rest[0] != "add":
            die("remote: only add and summary", 99)
        opts = [r for r in rest[1:] if r.startswith("--")]
        name, url = [r for r in rest[1:] if not r.startswith("--")]
        home = os.path.join(repo, "gnupg-" + name)
        os.makedirs(home, mode=0o700, exist_ok=True)
        for o in opts:
            if o.startswith("--gpg-import="):
                if subprocess.run(["gpg", "--homedir", home, "--batch", "--quiet", "--import", o.split("=", 1)[1]]).returncode != 0:
                    die("remote add: cannot import the key")
        with open(os.path.join(repo, "remote-" + name), "w") as f:
            f.write(url + "\n")
        with open(os.path.join(repo, "remote-" + name + ".opts"), "w") as f:
            f.write(" ".join(opts) + "\n")
    elif command == "pull":
        # pull [--untrusted] REMOTE REF...: copies the head commit of each ref, refusing one whose signature the remote's keyring does not accept
        name, refs = [r for r in rest if not r.startswith("--")][0], [r for r in rest if not r.startswith("--")][1:]
        with open(os.path.join(repo, "remote-" + name)) as f:
            src = f.read().strip()[len("file://"):]
        home = os.path.join(repo, "gnupg-" + name)
        with open(os.path.join(repo, "remote-" + name + ".opts")) as f:
            if "gpg-verify-summary=true" in f.read():
                done = subprocess.run(["gpg", "--homedir", home, "--batch", "--status-fd", "1", "--verify", os.path.join(src, "summary.sig"), os.path.join(src, "summary")],
                                      capture_output=True, text=True) if os.path.isfile(os.path.join(src, "summary.sig")) else None
                if done is None or done.returncode != 0 or "[GNUPG:] VALIDSIG" not in done.stdout:
                    die("pull: the summary is not signed by a key of the remote")
        summary = {}
        if os.path.isfile(os.path.join(src, "summary")):
            with open(os.path.join(src, "summary")) as f:
                summary = dict(line.split() for line in f)
        for ref in refs:
            # Like ostree: with a summary, the commit of a ref is the one the summary names, whatever refs/heads says
            commit = summary.get(ref) or read_ref(src, ref)
            sig = commit_path(src, commit, ".commitmeta")
            done = subprocess.run(["gpg", "--homedir", home, "--batch", "--status-fd", "1", "--verify", sig, commit_path(src, commit)],
                                  capture_output=True, text=True) if os.path.isfile(sig) else None
            if done is None or done.returncode != 0 or "[GNUPG:] VALIDSIG" not in done.stdout:
                die("pull: the commit of %s is not signed by a key of the remote" % ref)
            for suffix in (".commit", ".commitmeta"):
                os.makedirs(os.path.dirname(commit_path(repo, commit)), exist_ok=True)
                shutil.copy(commit_path(src, commit, suffix), commit_path(repo, commit, suffix))
            write_ref(repo, ref, commit)
    elif command == "gpg-sign":
        opts = [r for r in rest if r.startswith("--")]
        commit, keys = [r for r in rest if not r.startswith("--")][0], [r for r in rest if not r.startswith("--")][1:]
        home = [o.split("=", 1)[1] for o in opts if o.startswith("--gpg-homedir=")]
        source, target = commit_path(repo, commit), commit_path(repo, commit, ".commitmeta")
        if not os.path.isfile(source):
            die("gpg-sign: no commit %s" % commit)
        if os.path.exists(target):
            die("gpg-sign: commit %s is already signed" % commit)
        for key in keys:
            cmd = ["gpg", "--batch", "--yes", "--quiet", "--pinentry-mode", "error", "--local-user", key, "--detach-sign", "-o", target, source]
            if home:
                cmd[1:1] = ["--homedir", home[0]]
            if subprocess.run(cmd).returncode != 0:
                die("gpg-sign: signing %s failed" % commit)
    elif command == "show":
        key = [r for r in rest if r.startswith("--print-detached-metadata-key=")]
        commit = read_ref(repo, [r for r in rest if not r.startswith("--")][0])
        if "--print-metadata-key=ostree.collection-binding" in rest:
            print(repr(commit_lines(repo, commit).get("collection", "")))
            return
        if "--print-metadata-key=ostree.ref-binding" in rest:
            with open(commit_path(repo, commit)) as f:
                found = [line.strip()[len("binding="):] for line in f if line.startswith("binding=")]
            if not found:
                die("show: no such metadata key")
            print("['%s']" % found[0])
            return
        if "--list-metadata-keys" in rest:
            print("\n".join(commit_lines(repo, commit).get("keys", "ostree.collection-binding ostree.ref-binding").split()))
            return
        if not [r for r in rest if r.startswith("--")]:
            lines = commit_lines(repo, commit)
            with open(commit_path(repo, commit)) as f:
                body = f.read().split("\n")[1]
            stamp = time.strftime("%Y-%m-%d %H:%M:%S +0000", time.gmtime(int(lines.get("date", time.time()))))
            print("commit %s\nContentChecksum:  %s\nDate:  %s\n\n    %s\n" % (commit, "0" * 64, stamp, lines.get("subject", body)))
            if "message" in lines:
                print("    %s\n" % lines["message"])
            if os.path.isfile(commit_path(repo, commit, ".commitmeta")):
                print("Found 1 signature:\n\n  Signature made Fri Oct 30 20:42:25 2026 using EdDSA key ID 0000000000000000\n  Can't check signature: public key not found")
            return
        if key and os.path.isfile(commit_path(repo, commit, ".commitmeta")):
            print("[signature]")
    elif command == "cat":
        # cat REF PATH: only the metainfo of the app, whose first <release> is the version of the commit (a `version=` line, else the
        # first x.y.z of the body)
        commit = read_ref(repo, rest[0])
        with open(commit_path(repo, commit)) as f:
            body = f.read().split("\n")[1]
        version = commit_lines(repo, commit).get("version") or (re.findall(r"\d+\.\d+\.\d+", body) or [None])[0]
        if not version or not rest[1].endswith(".metainfo.xml"):
            die("cat: no such file " + rest[1])
        print('<component><releases><release version="%s" date="2026-01-01"/></releases></component>' % version)
    elif command == "fsck":
        base = os.path.join(repo, "refs", "heads")
        for root, _, files in os.walk(base):
            for name in files:
                commit = open(os.path.join(root, name)).read().strip()
                if not os.path.isfile(commit_path(repo, commit)):
                    die("fsck: %s names a missing commit" % name)
    elif command == "fake-commit":
        ref, body = rest[0], rest[1]
        if not os.path.isfile(os.path.join(repo, "config")):
            write_config(repo)
        path = os.path.join(repo, "refs", "heads", ref)
        parent = read_ref(repo, ref) if os.path.isfile(path) and not os.environ.get("FAKE_OSTREE_ORPHAN") else "-"
        content = "parent=%s\n%s\nbinding=%s\ndate=%d\n" % (parent, body, ref, int(os.environ.get("FAKE_OSTREE_DATE") or time.time()))
        commit = hashlib.sha256(content.encode()).hexdigest()  # as in ostree: the id is the checksum of the commit object
        os.makedirs(os.path.dirname(commit_path(repo, commit)), exist_ok=True)
        with open(commit_path(repo, commit), "w") as f:
            f.write(content)
        write_ref(repo, ref, commit)
        print(commit)
    else:
        die("unsupported command: " + command, 99)


main()
