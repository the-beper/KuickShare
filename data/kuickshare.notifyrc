[Global]
IconName=io.github.the_beper.KuickShare
Name=KuickShare
Comment=Quick Share client for KDE Plasma
DesktopEntry=io.github.the_beper.KuickShare

[Event/incomingTransfer]
Name=Incoming Transfer
Comment=A nearby device wants to send something and waits for your answer
Action=Popup

[Event/transferFinished]
Name=Content Received
Comment=Files, text or a link arrived from a nearby device
Action=Popup

[Event/transferFailed]
Name=Transfer Failed
Comment=An offer was refused, or a transfer was not accepted or was interrupted
Action=Popup

[Event/wifiJoined]
Name=Wi-Fi Network Joined
Comment=A Wi-Fi network shared by a phone was joined automatically
Action=Popup

[Event/wifiJoinFailed]
Name=Could Not Join Wi-Fi
Comment=A Wi-Fi network shared by a phone could not be joined
Action=Popup
