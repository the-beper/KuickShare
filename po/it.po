#: src/core/desktop.rs:90 src/core/desktop.rs:1252 src/shell/corebridge.cpp:762
msgid ""
"The offer has too many files. Ask the sender to send fewer files at once"
msgstr ""
"L’offerta contiene troppi file. Chiedi al mittente di inviarne meno alla "
"volta"

#: src/core/desktop.rs:94 src/core/desktop.rs:1257 src/shell/corebridge.cpp:766
msgid ""
"There is not enough free space in the download folder. Free some space or "
"choose another download folder in Preferences"
msgstr ""
"Non c’è abbastanza spazio libero nella cartella di download. Libera spazio o "
"scegli un’altra cartella di download nelle Preferenze"

#: src/core/desktop.rs:98 src/core/desktop.rs:1263 src/shell/corebridge.cpp:770
msgid ""
"The download folder cannot be used. Choose another download folder in "
"Preferences"
msgstr ""
"La cartella di download non può essere usata. Scegline un’altra nelle "
"Preferenze"

#: src/core/desktop.rs:101 src/core/desktop.rs:1269
#: src/shell/corebridge.cpp:774
msgid ""
"A file name in the offer cannot be saved. Ask the sender to rename the file "
"and send it again"
msgstr ""
"Il nome di un file dell’offerta non può essere salvato. Chiedi al mittente "
"di rinominare il file e di inviarlo di nuovo"

#: src/core/desktop.rs:104 src/core/desktop.rs:1274 src/core/desktop.rs:1278
#: src/shell/corebridge.cpp:778
msgid "The offer is malformed. Ask the sender to try again"
msgstr "L’offerta non è valida. Chiedi al mittente di riprovare"

#: src/core/desktop.rs:110 src/core/desktop.rs:1283
#: src/shell/corebridge.cpp:781
msgid ""
"The offer was refused for an unknown reason. Ask the sender to try again"
msgstr ""
"L’offerta è stata rifiutata per un motivo sconosciuto. Chiedi al mittente di "
"riprovare"

#: src/core/notify.rs:182
msgid "A nearby device"
msgstr "Un dispositivo vicino"

#: src/core/notify.rs:184
msgid "%1 wants to share with you"
msgstr "%1 vuole condividere con te"

#: src/core/notify.rs:187
msgid ""
"%1 wants to share with you\n"
"PIN: %2"
msgstr ""
"%1 vuole condividere con te\n"
"PIN: %2"

#: src/core/notify.rs:192
msgid ""
"“Accept and Trust” recognises this device by its name and network address, "
"which another device on the same network can copy"
msgstr ""
"“Accetta e fidati” riconosce questo dispositivo in base al nome e "
"all’indirizzo di rete, che un altro dispositivo della stessa rete può copiare"

#: src/core/notify.rs:196
msgctxt "@action:button"
msgid "Accept"
msgstr "Accetta"

#: src/core/notify.rs:200
msgctxt "@action:button"
msgid "Accept and Trust"
msgstr "Accetta e fidati"

#: src/core/notify.rs:203
msgctxt "@action:button"
msgid "Decline"
msgstr "Rifiuta"

#: src/core/notify.rs:207
