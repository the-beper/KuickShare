msgid "KuickShare"
msgstr "KuickShare"

#: src/shell/qml/Main.qml:126
msgid "Quit KuickShare?"
msgstr "Uscire da KuickShare?"

#: src/shell/qml/Main.qml:127
msgid "A transfer is in progress. Quitting stops it"
msgstr "È in corso un trasferimento. Uscendo verrà interrotto"

#: src/shell/qml/Main.qml:176
msgid "Connected to %1"
msgstr "Connesso a %1"

#: src/shell/qml/Main.qml:183
msgid "Transfer completed"
msgstr "Trasferimento completato"

#: src/shell/qml/Main.qml:186
msgid "The transfer failed"
msgstr "Il trasferimento non è riuscito"

#: src/shell/qml/Main.qml:189
msgid "The transfer was declined"
msgstr "Il trasferimento è stato rifiutato"

#: src/shell/qml/Main.qml:192
msgid "The transfer was cancelled"
msgstr "Il trasferimento è stato annullato"

