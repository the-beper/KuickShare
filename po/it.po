#: src/shell/corebridge.cpp:574
msgid "This transfer is no longer waiting for an answer"
msgstr "Questo trasferimento non attende più una risposta"

#: src/shell/corebridge.cpp:581
msgid "This device cannot be trusted: its network address is not known"
msgstr ""
"Questo dispositivo non può essere considerato attendibile: il suo indirizzo "
"di rete non è noto"

#: src/shell/corebridge.cpp:583
msgid "This device cannot be trusted: it sent no name"
msgstr ""
"Questo dispositivo non può essere considerato attendibile: non ha inviato "
"alcun nome"

#: src/shell/corebridge.cpp:585
msgid ""
"This device cannot be trusted: its network address now belongs to another "
"device"
msgstr ""
"Questo dispositivo non può essere considerato attendibile: il suo indirizzo "
"di rete appartiene ora a un altro dispositivo"

#: src/shell/corebridge.cpp:596
msgid "The offer has too many files"
msgstr "La richiesta contiene troppi file"

#: src/shell/corebridge.cpp:600
msgid "There is not enough free space in the download folder"
msgstr "Non c’è abbastanza spazio libero nella cartella di download"

#: src/shell/corebridge.cpp:604
msgid "The download folder cannot be used"
msgstr "La cartella di download non può essere usata"

#: src/shell/corebridge.cpp:608
msgid "A file name in the offer cannot be saved"
msgstr "Il nome di un file della richiesta non può essere salvato"

#: src/shell/corebridge.cpp:612
msgid "The offer is malformed"
msgstr "La richiesta non è valida"

#: src/shell/corebridge.cpp:615
msgid "The offer was refused"
msgstr "La richiesta è stata rifiutata"

#: src/shell/corebridge.cpp:650
msgid "Bluetooth (BlueZ)"
msgstr "Bluetooth (BlueZ)"

#: src/shell/corebridge.cpp:653
msgid "NetworkManager"
msgstr "NetworkManager"

#: src/shell/corebridge.cpp:656
msgid "Wi-Fi adapter"
msgstr "Adattatore Wi-Fi"

#: src/shell/corebridge.cpp:659
msgid "Hotspot addresses (dnsmasq)"
msgstr "Indirizzi dell’hotspot (dnsmasq)"

#: src/shell/corebridge.cpp:662
msgid "Firewall (firewalld)"
msgstr "Firewall (firewalld)"

#: src/shell/corebridge.cpp:665
msgid "Flatpak permissions"
msgstr "Permessi del Flatpak"

#: src/shell/corebridge.cpp:680
msgid "The check took too long"
msgstr "La verifica ha impiegato troppo tempo"

#: src/shell/corebridge.cpp:680
msgid ""
"Refresh to check again; if it keeps happening, the service it asks may be "
"busy or stuck"
msgstr ""
"Aggiorna per verificare di nuovo; se succede ancora, il servizio interrogato "
"potrebbe essere occupato o bloccato"

#: src/shell/corebridge.cpp:683
msgid "The system message bus could not be reached"
msgstr "Impossibile raggiungere il bus di messaggi di sistema"

#: src/shell/corebridge.cpp:683
msgid "The check needs the system D-Bus; refresh to try again"
msgstr "La verifica richiede il D-Bus di sistema; aggiorna per riprovare"

#: src/shell/corebridge.cpp:686
msgid "The service gave an answer that could not be understood"
msgstr "Il servizio ha dato una risposta non comprensibile"

#: src/shell/corebridge.cpp:686
msgid "Refresh to try again; if it persists, update the service"
msgstr "Aggiorna per riprovare; se il problema persiste, aggiorna il servizio"

#: src/shell/corebridge.cpp:689
msgid "The check failed"
msgstr "La verifica non è riuscita"

#: src/shell/corebridge.cpp:689
msgid "Refresh to try again"
msgstr "Aggiorna per riprovare"

#: src/shell/corebridge.cpp:692
msgid "Not checked, because something it depends on is not ready"
msgstr "Non verificato, perché qualcosa da cui dipende non è pronto"

#: src/shell/corebridge.cpp:692
msgid "Fix the items that are blocked or unknown first"
msgstr "Risolvi prima le voci bloccate o sconosciute"

#: src/shell/corebridge.cpp:697
msgid "The Bluetooth service is not running"
msgstr "Il servizio Bluetooth non è in esecuzione"

#: src/shell/corebridge.cpp:697
msgid ""
"Start the Bluetooth service; if BlueZ is not installed, install it first"
msgstr ""
"Avvia il servizio Bluetooth; se BlueZ non è installato, installalo prima"

#: src/shell/corebridge.cpp:700
msgid "The Bluetooth service is installed but not running"
msgstr "Il servizio Bluetooth è installato ma non è in esecuzione"

#: src/shell/corebridge.cpp:700 src/shell/corebridge.cpp:753
msgid "It starts when something needs it; to start it now, use the command"
msgstr "Si avvia quando serve; per avviarlo subito, usa il comando"

#: src/shell/corebridge.cpp:703
msgid "The sandbox hides the Bluetooth service"
msgstr "La sandbox nasconde il servizio Bluetooth"

#: src/shell/corebridge.cpp:703
msgid "Allow the sandbox to talk to BlueZ, then restart KuickShare"
msgstr "Consenti alla sandbox di comunicare con BlueZ, poi riavvia KuickShare"

#: src/shell/corebridge.cpp:707
msgid "No Bluetooth adapter was found"
msgstr "Nessun adattatore Bluetooth trovato"

#: src/shell/corebridge.cpp:707
msgid ""
"Plug in or enable a Bluetooth adapter; if one is installed, check that its "
"driver is loaded"
msgstr ""
"Collega o attiva un adattatore Bluetooth; se ne è installato uno, controlla "
"che il suo driver sia caricato"

#: src/shell/corebridge.cpp:711
msgid "The Bluetooth adapter is turned off"
msgstr "L’adattatore Bluetooth è spento"

#: src/shell/corebridge.cpp:711
msgid ""
"KuickShare turns it on when it needs it; you can also turn Bluetooth on in "
"the system settings"
msgstr ""
"KuickShare lo accende quando serve; puoi anche attivare il Bluetooth nelle "
"impostazioni di sistema"

#: src/shell/corebridge.cpp:714
msgid "Blocked by a radio switch"
msgstr "Bloccato da un interruttore radio"

#: src/shell/corebridge.cpp:714
msgid "Turn Bluetooth on in the system settings"
msgstr "Attiva il Bluetooth nelle impostazioni di sistema"

#: src/shell/corebridge.cpp:718
msgid "The Bluetooth adapter does not support Bluetooth Low Energy"
msgstr "L’adattatore Bluetooth non supporta Bluetooth Low Energy"

#: src/shell/corebridge.cpp:718
msgid "Use an adapter that supports Bluetooth 4.0 or newer"
msgstr "Usa un adattatore che supporta Bluetooth 4.0 o successivo"

#: src/shell/corebridge.cpp:721
msgid "BlueZ does not report what the adapter can do"
msgstr "BlueZ non riporta le funzioni dell’adattatore"

#: src/shell/corebridge.cpp:721 src/shell/corebridge.cpp:735
msgid "This may still work; a newer BlueZ reports it"
msgstr "Potrebbe funzionare comunque; un BlueZ più recente lo segnala"

#: src/shell/corebridge.cpp:725
msgid "The Bluetooth adapter cannot advertise"
msgstr "L’adattatore Bluetooth non può trasmettere annunci"

#: src/shell/corebridge.cpp:725
msgid ""
"Receiving by Bluetooth needs an adapter that can advertise; sending is not "
"affected"
msgstr ""
"Ricevere via Bluetooth richiede un adattatore che può trasmettere annunci; "
"l’invio non è influenzato"

#: src/shell/corebridge.cpp:728
msgid "The adapter has no free advertising slot now"
msgstr "L’adattatore non ha al momento slot liberi per gli annunci"

#: src/shell/corebridge.cpp:728
msgid "Another program uses them; close it and refresh"
msgstr "Un altro programma li usa; chiudilo e aggiorna"

#: src/shell/corebridge.cpp:732
msgid "The Bluetooth adapter cannot scan for devices"
msgstr "L’adattatore Bluetooth non può cercare dispositivi"

#: src/shell/corebridge.cpp:732
msgid "Sending needs an adapter that can scan; use another one"
msgstr ""
"L’invio richiede un adattatore che possa cercare dispositivi; usane un altro"

#: src/shell/corebridge.cpp:735
msgid "BlueZ does not report how the adapter can scan"
msgstr "BlueZ non riporta come l’adattatore può cercare"

#: src/shell/corebridge.cpp:739
msgid "BlueZ offers no GATT services"
msgstr "BlueZ non offre servizi GATT"

#: src/shell/corebridge.cpp:739
msgid "Update BlueZ to a version with GATT support"
msgstr "Aggiorna BlueZ a una versione con supporto GATT"

#: src/shell/corebridge.cpp:743
msgid "The sandbox does not allow Bluetooth sockets"
msgstr "La sandbox non consente i socket Bluetooth"

#: src/shell/corebridge.cpp:743
msgid ""
"Transfers still work over a slower path; allow Bluetooth for the Flatpak to "
"use the faster one"
msgstr ""
"I trasferimenti funzionano ancora su un percorso più lento; consenti al "
"Flatpak di usare il Bluetooth per passare a quello più veloce"

#: src/shell/corebridge.cpp:746
msgid "The kernel does not report Bluetooth socket support"
msgstr "Il kernel non segnala il supporto ai socket Bluetooth"

#: src/shell/corebridge.cpp:746
msgid "Transfers still work over a slower path if it is missing"
msgstr "I trasferimenti funzionano comunque su un percorso più lento, se manca"

#: src/shell/corebridge.cpp:750
msgid "NetworkManager is not running"
msgstr "NetworkManager non è in esecuzione"

#: src/shell/corebridge.cpp:750
msgid ""
"Wi-Fi Direct needs NetworkManager; start it, or install it if this system "
"uses another network tool"
msgstr ""
"Wi-Fi Direct richiede NetworkManager; avvialo, oppure installalo se questo "
"sistema usa un altro strumento di rete"

#: src/shell/corebridge.cpp:753
msgid "NetworkManager is installed but not running"
msgstr "NetworkManager è installato ma non è in esecuzione"

#: src/shell/corebridge.cpp:756
msgid "The sandbox hides NetworkManager"
msgstr "La sandbox nasconde NetworkManager"

#: src/shell/corebridge.cpp:756
msgid "Allow the sandbox to talk to NetworkManager, then restart KuickShare"
msgstr ""
"Consenti alla sandbox di comunicare con NetworkManager, poi riavvia "
"KuickShare"

#: src/shell/corebridge.cpp:760
msgid "Networking is turned off in NetworkManager"
msgstr "La rete è disattivata in NetworkManager"

#: src/shell/corebridge.cpp:760
msgid "Turn networking on in the network settings"
msgstr "Attiva la rete nelle impostazioni di rete"

#: src/shell/corebridge.cpp:764
msgid "Wi-Fi is turned off"
msgstr "Il Wi-Fi è disattivato"

#: src/shell/corebridge.cpp:764
msgid "Turn Wi-Fi on in the system settings"
msgstr "Attiva il Wi-Fi nelle impostazioni di sistema"

#: src/shell/corebridge.cpp:768
msgid "A hardware switch has turned the Wi-Fi radio off"
msgstr "Un interruttore hardware ha spento la radio Wi-Fi"

#: src/shell/corebridge.cpp:768
msgid "Use the Wi-Fi switch or key of this system"
msgstr "Usa l’interruttore o il tasto Wi-Fi di questo sistema"

#: src/shell/corebridge.cpp:772
msgid "There are several Wi-Fi adapters; the first one is used"
msgstr "Ci sono più adattatori Wi-Fi; si usa il primo"

#: src/shell/corebridge.cpp:772
msgid "If transfers fail, turn off the adapters you do not need"
msgstr ""
"Se i trasferimenti non riescono, disattiva gli adattatori che non ti servono"

#: src/shell/corebridge.cpp:775
msgid "No Wi-Fi adapter was found"
msgstr "Nessun adattatore Wi-Fi trovato"

#: src/shell/corebridge.cpp:775
msgid ""
"Plug in a Wi-Fi adapter, or check that the driver of the built-in one is "
"loaded"
msgstr ""
"Collega un adattatore Wi-Fi, oppure controlla che il driver di quello "
"integrato sia caricato"

#: src/shell/corebridge.cpp:779
msgid "NetworkManager does not manage the Wi-Fi adapter"
msgstr "NetworkManager non gestisce l’adattatore Wi-Fi"

#: src/shell/corebridge.cpp:779
msgid ""
"Let NetworkManager manage it: another network tool or an unmanaged-devices "
"setting may be holding it"
msgstr ""
"Lascia che sia NetworkManager a gestirlo: potrebbe trattenerlo un altro "
"strumento di rete o un’impostazione dei dispositivi non gestiti"

#: src/shell/corebridge.cpp:783
msgid "The Wi-Fi adapter needs firmware that is not installed"
msgstr "L’adattatore Wi-Fi richiede un firmware non installato"

#: src/shell/corebridge.cpp:783
msgid ""
"Install the firmware package for the adapter (often linux-firmware), then "
"restart this system"
msgstr ""
"Installa il pacchetto firmware per l’adattatore (spesso linux-firmware), poi "
"riavvia questo sistema"

#: src/shell/corebridge.cpp:787
msgid "The NetworkManager plugin for the Wi-Fi adapter is missing"
msgstr "Manca il plugin di NetworkManager per l’adattatore Wi-Fi"

#: src/shell/corebridge.cpp:787
msgid ""
"Install the NetworkManager Wi-Fi plugin package of your distribution, then "
"restart NetworkManager"
msgstr ""
"Installa il pacchetto del plugin Wi-Fi di NetworkManager della tua "
"distribuzione, poi riavvia NetworkManager"

#: src/shell/corebridge.cpp:790
msgid "NetworkManager reports the Wi-Fi adapter as unavailable"
msgstr "NetworkManager segnala l’adattatore Wi-Fi come non disponibile"

#: src/shell/corebridge.cpp:790
msgid "Check that its driver loaded and its radio is on"
msgstr "Controlla che il suo driver sia caricato e che la sua radio sia accesa"

#: src/shell/corebridge.cpp:794
msgid "NetworkManager asks for authentication to control the network"
msgstr "NetworkManager chiede l’autenticazione per controllare la rete"

#: src/shell/corebridge.cpp:794
msgid ""
"The hotspot may prompt for a password or be refused; allow network control "
"for your user in the PolicyKit settings"
msgstr ""
"L’hotspot potrebbe chiedere una password o essere rifiutato; consenti il "
"controllo della rete per il tuo utente nelle impostazioni di PolicyKit"

#: src/shell/corebridge.cpp:797
msgid "NetworkManager does not allow this user to control the network"
msgstr "NetworkManager non consente a questo utente di controllare la rete"

#: src/shell/corebridge.cpp:797
msgid ""
"Ask the administrator to allow network control and changes to system "
"connections for your user"
msgstr ""
"Chiedi all’amministratore di consentire al tuo utente il controllo della "
"rete e la modifica delle connessioni di sistema"

#: src/shell/corebridge.cpp:801
msgid "Joining Wi-Fi cannot work: something it needs is blocked"
msgstr ""
"La connessione a reti Wi-Fi non può funzionare: qualcosa di cui ha bisogno è "
"bloccato"

#: src/shell/corebridge.cpp:801
msgid "Fix the blocked items of NetworkManager and the Wi-Fi adapter"
msgstr "Risolvi le voci bloccate di NetworkManager e dell’adattatore Wi-Fi"

#: src/shell/corebridge.cpp:804
msgid ""
"It is not known whether joining Wi-Fi works: something it needs could not be "
"checked"
msgstr ""
"Non si sa se la connessione a reti Wi-Fi funzioni: non è stato possibile "
"verificare qualcosa di cui ha bisogno"

#: src/shell/corebridge.cpp:804
msgid "Refresh when the items above are sorted out"
msgstr "Aggiorna quando sono risolte le voci sopra"

#: src/shell/corebridge.cpp:807 src/shell/corebridge.cpp:829
msgid "The sandbox has no network access"
msgstr "La sandbox non ha accesso alla rete"

#: src/shell/corebridge.cpp:807 src/shell/corebridge.cpp:829
msgid "Allow the network for the Flatpak"
msgstr "Consenti l’accesso alla rete per il Flatpak"

#: src/shell/corebridge.cpp:811
msgid "The Wi-Fi adapter cannot create a hotspot"
msgstr "L’adattatore Wi-Fi non può creare un hotspot"

#: src/shell/corebridge.cpp:811
msgid ""
"Receiving by Wi-Fi needs an adapter with access point mode; Bluetooth still "
"works"
msgstr ""
"Ricevere via Wi-Fi richiede un adattatore con modalità access point; il "
"Bluetooth continua a funzionare"

#: src/shell/corebridge.cpp:814
msgid "The Wi-Fi adapter cannot protect a hotspot with WPA2"
msgstr "L’adattatore Wi-Fi non può proteggere un hotspot con WPA2"

#: src/shell/corebridge.cpp:814
msgid "Receiving by Wi-Fi needs WPA2 on the adapter; Bluetooth still works"
msgstr ""
"Ricevere via Wi-Fi richiede WPA2 sull’adattatore; il Bluetooth continua a "
"funzionare"

#: src/shell/corebridge.cpp:817
msgid "The Wi-Fi adapter reports no 2.4 GHz or 5 GHz band for a hotspot"
msgstr ""
"L’adattatore Wi-Fi non segnala alcuna banda a 2,4 GHz o a 5 GHz per un "
"hotspot"

#: src/shell/corebridge.cpp:817
msgid "Receiving by Wi-Fi needs one of them; Bluetooth still works"
msgstr ""
"Ricevere via Wi-Fi richiede una delle due; il Bluetooth continua a funzionare"

#: src/shell/corebridge.cpp:820
msgid "The Wi-Fi driver does not report what the adapter can do"
msgstr "Il driver Wi-Fi non segnala le funzioni dell’adattatore"

#: src/shell/corebridge.cpp:820
msgid "The hotspot may still work; it could not be checked"
msgstr ""
"L’hotspot potrebbe funzionare comunque; non è stato possibile verificarlo"

#: src/shell/corebridge.cpp:823
msgid "NetworkManager asks for authentication to share a connection"
msgstr "NetworkManager chiede l’autenticazione per condividere una connessione"

#: src/shell/corebridge.cpp:823
msgid ""
"The hotspot may prompt for a password or be refused; allow it in the "
"PolicyKit settings"
msgstr ""
"L’hotspot potrebbe chiedere una password o essere rifiutato; consentilo "
"nelle impostazioni di PolicyKit"

#: src/shell/corebridge.cpp:826
msgid "This user may not share a connection"
msgstr "Questo utente non può condividere una connessione"

#: src/shell/corebridge.cpp:826
msgid "Ask the administrator to allow sharing connections in NetworkManager"
msgstr ""
"Chiedi all’amministratore di consentire la condivisione delle connessioni in "
"NetworkManager"

#: src/shell/corebridge.cpp:833
msgid "dnsmasq is installed"
msgstr "dnsmasq è installato"

#: src/shell/corebridge.cpp:836
msgid "The hotspot already handed out addresses in this session"
msgstr "L’hotspot ha già assegnato indirizzi in questa sessione"

#: src/shell/corebridge.cpp:839
msgid "dnsmasq was not found"
msgstr "dnsmasq non è stato trovato"

#: src/shell/corebridge.cpp:839
msgid ""
"The hotspot hands out addresses with dnsmasq; install the dnsmasq or dnsmasq-"
"base package"
msgstr ""
"L’hotspot assegna gli indirizzi con dnsmasq; installa il pacchetto dnsmasq o "
"dnsmasq-base"

#: src/shell/corebridge.cpp:842
msgid "Checked when the first hotspot starts"
msgstr "Si verifica all’avvio del primo hotspot"

#: src/shell/corebridge.cpp:842
msgid "The sandbox cannot look for dnsmasq on this system"
msgstr "La sandbox non può cercare dnsmasq su questo sistema"

#: src/shell/corebridge.cpp:845
msgid "The hotspot could not start its address service"
msgstr "L’hotspot non è riuscito ad avviare il suo servizio di indirizzi"

#: src/shell/corebridge.cpp:845
msgid "Install the dnsmasq or dnsmasq-base package"
msgstr "Installa il pacchetto dnsmasq o dnsmasq-base"

#: src/shell/corebridge.cpp:849
msgid "The firewall service (firewalld) is not running"
msgstr "Il servizio firewall (firewalld) non è in esecuzione"

#: src/shell/corebridge.cpp:849
msgid ""
"KuickShare cannot open the hotspot port by itself; it asks you before the "
"hotspot uses an open zone"
msgstr ""
"KuickShare non può aprire da sola la porta dell’hotspot; ti chiede prima che "
"l’hotspot usi una zona aperta"

#: src/shell/corebridge.cpp:852
msgid "The sandbox hides the firewall service"
msgstr "La sandbox nasconde il servizio firewall"

#: src/shell/corebridge.cpp:852
msgid "Allow the sandbox to talk to firewalld, then restart KuickShare"
msgstr ""
"Consenti alla sandbox di comunicare con firewalld, poi riavvia KuickShare"

#: src/shell/corebridge.cpp:855
msgid "The firewall has no zone for the hotspot (nm-shared)"
msgstr "Il firewall non ha una zona per l’hotspot (nm-shared)"

#: src/shell/corebridge.cpp:855
msgid "The hotspot may be blocked or open; add the zone or check its rules"
msgstr ""
"L’hotspot potrebbe essere bloccato o aperto; aggiungi la zona o controlla le "
"sue regole"

#: src/shell/corebridge.cpp:858
msgid "Changing the firewall asks for authentication"
msgstr "Modificare il firewall richiede l’autenticazione"

#: src/shell/corebridge.cpp:858
msgid "Opening the hotspot port may prompt for a password or be refused"
msgstr ""
"Aprire la porta dell’hotspot potrebbe chiedere una password o essere "
"rifiutato"

#: src/shell/corebridge.cpp:861
msgid "This user may not change the firewall"
msgstr "Questo utente non può modificare il firewall"

#: src/shell/corebridge.cpp:861
msgid "The hotspot port cannot be opened; ask the administrator to allow it"
msgstr ""
"La porta dell’hotspot non può essere aperta; chiedi all’amministratore di "
"consentirlo"

#: src/shell/corebridge.cpp:864
msgid "It cannot be checked whether this user may change the firewall"
msgstr "Non è possibile verificare se questo utente può modificare il firewall"

#: src/shell/corebridge.cpp:864
msgid "polkit could not be asked without a prompt; the hotspot is tried anyway"
msgstr ""
"polkit non può essere interpellato senza chiedere l’autenticazione; "
"l’hotspot viene comunque provato"

#: src/shell/corebridge.cpp:867
msgid "The firewall refused the hotspot in this session"
msgstr "Il firewall ha rifiutato l’hotspot in questa sessione"

#: src/shell/corebridge.cpp:867
msgid ""
"Allow the hotspot in the firewall, or let it use an open zone when asked"
msgstr ""
"Consenti l’hotspot nel firewall, oppure consenti che usi una zona aperta "
"quando viene chiesto"

#: src/shell/corebridge.cpp:870
msgid "You allowed the hotspot to use an open firewall zone in this session"
msgstr ""
"Hai consentito all’hotspot di usare una zona firewall aperta in questa "
"sessione"

#: src/shell/corebridge.cpp:870
msgid "Turning the setting off takes this back"
msgstr "Disattivare l’impostazione annulla questa scelta"

#: src/shell/corebridge.cpp:875
msgid "The Flatpak lacks permissions it needs"
msgstr "Al Flatpak mancano dei permessi necessari"

#: src/shell/corebridge.cpp:875
msgid "Allow them, then restart KuickShare"
msgstr "Consentili, poi riavvia KuickShare"

#: src/shell/corebridge.cpp:878
msgid "The Flatpak can see the whole file system"
msgstr "Il Flatpak può vedere l’intero file system"

#: src/shell/corebridge.cpp:878
msgid "It does not need to; take that permission away"
msgstr "Non ne ha bisogno; togli quel permesso"

#: src/shell/corebridge.cpp:882
msgid "No more information is available"
msgstr "Non ci sono altre informazioni"

#: src/shell/corebridge.cpp:889
msgctxt "@info:status requirement check"
msgid "Ready"
msgstr "Pronto"

#: src/shell/corebridge.cpp:891
msgctxt "@info:status requirement check"
msgid "Warning"
msgstr "Avviso"

#: src/shell/corebridge.cpp:893
msgctxt "@info:status requirement check"
msgid "Blocked"
msgstr "Bloccato"

#: src/shell/corebridge.cpp:895
msgctxt "@info:status requirement check"
msgid "Checking"
msgstr "In verifica"

#: src/shell/corebridge.cpp:899
msgctxt "@info:status requirement check"
msgid "Unknown"
msgstr "Sconosciuto"

#: src/shell/corebridge.cpp:923
msgctxt "@info:status capability"
msgid "Available"
msgstr "Disponibile"

#: src/shell/corebridge.cpp:925
msgctxt "@info:status capability"
msgid "Limited"
msgstr "Limitato"

#: src/shell/corebridge.cpp:927
msgctxt "@info:status capability"
msgid "Unavailable"
msgstr "Non disponibile"

#: src/shell/corebridge.cpp:931
msgctxt "@info:status capability"
msgid "Unknown"
msgstr "Sconosciuto"

#: src/shell/corebridge.cpp:1224
msgid "Could not update Dolphin’s context menu"
msgstr "Impossibile aggiornare il menu contestuale di Dolphin"

#: src/shell/corebridge.cpp:1248
msgid "Could not update the application menu"
msgstr "Impossibile aggiornare il menu delle applicazioni"

#: src/shell/corebridge.cpp:1259
msgid "Could not add KuickShare to the menus"
msgstr "Impossibile aggiungere KuickShare ai menu"

#: src/shell/corebridge.cpp:1316 src/shell/corebridge.cpp:1323
msgid "The sharing service did not accept the request"
msgstr "Il servizio di condivisione non ha accettato la richiesta"

#: src/shell/corebridge.cpp:1420
msgid ""
"The Flatpak has no access to %1. Allow it with: flatpak override --user --"
"filesystem=\"%1\" %2"
msgstr ""
"Il Flatpak non ha accesso a %1. Consentilo con: flatpak override --user --"
"filesystem=\"%1\" %2"

#: src/shell/corebridge.cpp:1467
msgid "Could not update the autostart entry"
msgstr "Impossibile aggiornare la voce di avvio automatico"

#: src/shell/corebridge.cpp:1581
msgid "The folder %1 has more than %2 files"
