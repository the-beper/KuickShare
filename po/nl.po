#: src/shell/corebridge.cpp:573
msgid "This transfer is no longer waiting for an answer"
msgstr "Deze overdracht wacht niet meer op een antwoord"

#: src/shell/corebridge.cpp:580
msgid "This device cannot be trusted: its network address is not known"
msgstr "Dit apparaat kan niet worden vertrouwd: het netwerkadres is onbekend"

#: src/shell/corebridge.cpp:582
msgid "This device cannot be trusted: it sent no name"
msgstr "Dit apparaat kan niet worden vertrouwd: het heeft geen naam verstuurd"

#: src/shell/corebridge.cpp:584
msgid ""
"This device cannot be trusted: its network address now belongs to another "
"device"
msgstr ""
"Dit apparaat kan niet worden vertrouwd: het netwerkadres hoort nu bij een "
"ander apparaat"

#: src/shell/corebridge.cpp:595
msgid "The offer has too many files"
msgstr "Het verzoek bevat te veel bestanden"

#: src/shell/corebridge.cpp:599
msgid "There is not enough free space in the download folder"
msgstr "Er is niet genoeg vrije ruimte in de downloadmap"

#: src/shell/corebridge.cpp:603
msgid "The download folder cannot be used"
msgstr "De downloadmap kan niet worden gebruikt"

#: src/shell/corebridge.cpp:607
msgid "A file name in the offer cannot be saved"
msgstr "Een bestandsnaam in het verzoek kan niet worden opgeslagen"

#: src/shell/corebridge.cpp:611
msgid "The offer is malformed"
msgstr "Het verzoek is ongeldig"

#: src/shell/corebridge.cpp:614
msgid "The offer was refused"
msgstr "Het verzoek is geweigerd"

#: src/shell/corebridge.cpp:648
msgid "Bluetooth service (BlueZ)"
msgstr "Bluetooth-service (BlueZ)"

#: src/shell/corebridge.cpp:651
msgid "Bluetooth adapter"
msgstr "Bluetooth-adapter"

#: src/shell/corebridge.cpp:654
msgid "Bluetooth power"
msgstr "Bluetooth ingeschakeld"

#: src/shell/corebridge.cpp:657
msgid "Bluetooth Low Energy"
msgstr "Bluetooth Low Energy"

#: src/shell/corebridge.cpp:660
msgid "Bluetooth advertising"
msgstr "Bluetooth-advertising"

#: src/shell/corebridge.cpp:663
msgid "Bluetooth scanning"
msgstr "Bluetooth-zoeken"

#: src/shell/corebridge.cpp:666
msgid "Bluetooth GATT services"
msgstr "Bluetooth GATT-services"

#: src/shell/corebridge.cpp:669
msgid "Bluetooth fast channel (L2CAP)"
msgstr "Bluetooth-snelkanaal (L2CAP)"

#: src/shell/corebridge.cpp:672
msgid "NetworkManager"
msgstr "NetworkManager"

#: src/shell/corebridge.cpp:675
msgid "Networking switch"
msgstr "Netwerkschakelaar"

#: src/shell/corebridge.cpp:678
msgid "Wi-Fi switch"
msgstr "Wifi-schakelaar"

#: src/shell/corebridge.cpp:681
msgid "Wi-Fi radio switch"
msgstr "Wifi-radioschakelaar"

#: src/shell/corebridge.cpp:684
msgid "Wi-Fi adapter"
msgstr "Wifi-adapter"

#: src/shell/corebridge.cpp:687
msgid "Wi-Fi adapter management"
msgstr "Wifi-adapterbeheer"

#: src/shell/corebridge.cpp:690
msgid "Wi-Fi adapter firmware"
msgstr "Wifi-adapterfirmware"

#: src/shell/corebridge.cpp:693
msgid "Wi-Fi adapter driver"
msgstr "Wifi-adapterstuurprogramma"

#: src/shell/corebridge.cpp:696
msgid "NetworkManager permissions"
msgstr "Rechten van NetworkManager"

#: src/shell/corebridge.cpp:699
msgid "Wi-Fi client mode"
msgstr "Wifi-clientmodus"

#: src/shell/corebridge.cpp:702
msgid "Wi-Fi hotspot mode"
msgstr "Wifi-hotspotmodus"

#: src/shell/corebridge.cpp:705
msgid "Hotspot addresses (dnsmasq)"
msgstr "Adressen van de hotspot (dnsmasq)"

#: src/shell/corebridge.cpp:708
msgid "Firewall (firewalld)"
msgstr "Firewall (firewalld)"

#: src/shell/corebridge.cpp:711
msgid "Flatpak permissions"
msgstr "Flatpak-rechten"

#: src/shell/corebridge.cpp:726
msgid "Nothing is missing"
msgstr "Er ontbreekt niets"

#: src/shell/corebridge.cpp:729
msgid "The check took too long"
msgstr "De controle duurde te lang"

#: src/shell/corebridge.cpp:729
msgid ""
"Refresh to check again; if it keeps happening, the service it asks may be "
"busy or stuck"
msgstr "Vernieuw om opnieuw te controleren; als dit blijft gebeuren, is de service die wordt bevraagd mogelijk bezet of vastgelopen"

#: src/shell/corebridge.cpp:732
msgid "The system message bus could not be reached"
msgstr "De systeemberichtenbus kon niet worden bereikt"

#: src/shell/corebridge.cpp:732
msgid "The check needs the system D-Bus; refresh to try again"
msgstr "De controle heeft de systeem-D-Bus nodig; vernieuw om het opnieuw te proberen"

#: src/shell/corebridge.cpp:735
msgid "The service gave an answer that could not be understood"
msgstr "De service gaf een antwoord dat niet begrepen kon worden"

#: src/shell/corebridge.cpp:735
msgid "Refresh to try again; if it persists, update the service"
msgstr "Vernieuw om het opnieuw te proberen; blijft het probleem bestaan, werk dan de service bij"

#: src/shell/corebridge.cpp:738
msgid "The check failed"
msgstr "De controle is mislukt"

#: src/shell/corebridge.cpp:738
msgid "Refresh to try again"
msgstr "Vernieuw om het opnieuw te proberen"

#: src/shell/corebridge.cpp:741
msgid "Not checked, because something it depends on is not ready"
msgstr "Niet gecontroleerd, omdat iets waarvan het afhangt nog niet klaar is"

#: src/shell/corebridge.cpp:741
msgid "Fix the items that are blocked or unknown first"
msgstr "Los eerst de onderdelen op die geblokkeerd of onbekend zijn"

#: src/shell/corebridge.cpp:746
msgid "The Bluetooth service is not running"
msgstr "De Bluetooth-service draait niet"

#: src/shell/corebridge.cpp:746
msgid ""
"Start the Bluetooth service; if BlueZ is not installed, install it first"
msgstr "Start de Bluetooth-service; is BlueZ niet geïnstalleerd, installeer het dan eerst"

#: src/shell/corebridge.cpp:749
msgid "The Bluetooth service is installed but not running"
msgstr "De Bluetooth-service is geïnstalleerd maar draait niet"

#: src/shell/corebridge.cpp:749 src/shell/corebridge.cpp:802
msgid "It starts when something needs it; to start it now, use the command"
msgstr "Hij start wanneer iets hem nodig heeft; om hem nu te starten, gebruik de opdracht"

#: src/shell/corebridge.cpp:752
msgid "The sandbox hides the Bluetooth service"
msgstr "De sandbox verbergt de Bluetooth-service"

#: src/shell/corebridge.cpp:752
msgid "Allow the sandbox to talk to BlueZ, then restart KuickShare"
msgstr "Sta de sandbox toe om met BlueZ te communiceren en start KuickShare daarna opnieuw"

#: src/shell/corebridge.cpp:756
msgid "No Bluetooth adapter was found"
msgstr "Er is geen Bluetooth-adapter gevonden"

#: src/shell/corebridge.cpp:756
msgid ""
"Plug in or enable a Bluetooth adapter; if one is installed, check that its "
"driver is loaded"
msgstr "Sluit een Bluetooth-adapter aan of schakel er een in; is er al een geïnstalleerd, controleer dan of het stuurprogramma is geladen"

#: src/shell/corebridge.cpp:760
msgid "The Bluetooth adapter is turned off"
msgstr "De Bluetooth-adapter is uitgeschakeld"

#: src/shell/corebridge.cpp:760
msgid ""
"KuickShare turns it on when it needs it; you can also turn Bluetooth on in "
"the system settings"
msgstr "KuickShare schakelt hem in wanneer dat nodig is; je kunt Bluetooth ook inschakelen in de systeeminstellingen"

#: src/shell/corebridge.cpp:763
msgid "Blocked by a radio switch"
msgstr "Geblokkeerd door een radioschakelaar"

#: src/shell/corebridge.cpp:763
msgid "Turn Bluetooth on in the system settings"
msgstr "Schakel Bluetooth in via de systeeminstellingen"

#: src/shell/corebridge.cpp:767
msgid "The Bluetooth adapter does not support Bluetooth Low Energy"
msgstr "De Bluetooth-adapter ondersteunt Bluetooth Low Energy niet"

#: src/shell/corebridge.cpp:767
msgid "Use an adapter that supports Bluetooth 4.0 or newer"
msgstr "Gebruik een adapter die Bluetooth 4.0 of nieuwer ondersteunt"

#: src/shell/corebridge.cpp:770
msgid "BlueZ does not report what the adapter can do"
msgstr "BlueZ meldt niet wat de adapter kan"

#: src/shell/corebridge.cpp:770 src/shell/corebridge.cpp:784
msgid "This may still work; a newer BlueZ reports it"
msgstr "Het kan nog werken; een nieuwere BlueZ meldt dit"

#: src/shell/corebridge.cpp:774
msgid "The Bluetooth adapter cannot advertise"
msgstr "De Bluetooth-adapter ondersteunt geen advertising"

#: src/shell/corebridge.cpp:774
msgid ""
"Receiving by Bluetooth needs an adapter that can advertise; sending is not "
"affected"
msgstr "Ontvangen via Bluetooth vereist een adapter die advertising ondersteunt; versturen wordt niet beïnvloed"

#: src/shell/corebridge.cpp:777
msgid "The adapter has no free advertising slot now"
msgstr "De adapter heeft nu geen vrij advertising-slot"

#: src/shell/corebridge.cpp:777
msgid "Another program uses them; close it and refresh"
msgstr "Een ander programma gebruikt ze; sluit het af en vernieuw"

#: src/shell/corebridge.cpp:781
msgid "The Bluetooth adapter cannot scan for devices"
msgstr "De Bluetooth-adapter kan niet naar apparaten zoeken"

#: src/shell/corebridge.cpp:781
msgid "Sending needs an adapter that can scan; use another one"
msgstr "Versturen vereist een adapter die kan zoeken; gebruik een andere"

#: src/shell/corebridge.cpp:784
msgid "BlueZ does not report how the adapter can scan"
msgstr "BlueZ meldt niet hoe de adapter kan zoeken"

#: src/shell/corebridge.cpp:788
msgid "BlueZ offers no GATT services"
msgstr "BlueZ biedt geen GATT-services"

#: src/shell/corebridge.cpp:788
msgid "Update BlueZ to a version with GATT support"
msgstr "Werk BlueZ bij naar een versie met GATT-ondersteuning"

#: src/shell/corebridge.cpp:792
msgid "The sandbox does not allow Bluetooth sockets"
msgstr "De sandbox staat geen Bluetooth-sockets toe"

#: src/shell/corebridge.cpp:792
msgid ""
"Transfers still work over a slower path; allow Bluetooth for the Flatpak to "
"use the faster one"
msgstr "Overdrachten werken nog steeds via een tragere route; sta de Flatpak toe Bluetooth te gebruiken voor de snellere route"

#: src/shell/corebridge.cpp:795
msgid "The kernel does not report Bluetooth socket support"
msgstr "De kernel meldt geen ondersteuning voor Bluetooth-sockets"

#: src/shell/corebridge.cpp:795
msgid "Transfers still work over a slower path if it is missing"
msgstr "Overdrachten werken nog steeds via een tragere route als die ontbreekt"

#: src/shell/corebridge.cpp:799
msgid "NetworkManager is not running"
msgstr "NetworkManager draait niet"

#: src/shell/corebridge.cpp:799
msgid ""
"Wi-Fi Direct needs NetworkManager; start it, or install it if this computer "
"uses another network tool"
msgstr "Wi-Fi Direct heeft NetworkManager nodig; start het, of installeer het als deze computer een ander netwerkprogramma gebruikt"

#: src/shell/corebridge.cpp:802
msgid "NetworkManager is installed but not running"
msgstr "NetworkManager is geïnstalleerd maar draait niet"

#: src/shell/corebridge.cpp:805
msgid "The sandbox hides NetworkManager"
msgstr "De sandbox verbergt NetworkManager"

#: src/shell/corebridge.cpp:805
msgid "Allow the sandbox to talk to NetworkManager, then restart KuickShare"
msgstr "Sta de sandbox toe om met NetworkManager te communiceren en start KuickShare daarna opnieuw"

#: src/shell/corebridge.cpp:809
msgid "Networking is turned off in NetworkManager"
msgstr "Netwerken is uitgeschakeld in NetworkManager"

#: src/shell/corebridge.cpp:809
msgid "Turn networking on in the network settings"
msgstr "Schakel netwerken in via de netwerkinstellingen"

#: src/shell/corebridge.cpp:813
msgid "Wi-Fi is turned off"
msgstr "Wifi is uitgeschakeld"

#: src/shell/corebridge.cpp:813
msgid "Turn Wi-Fi on in the system settings"
msgstr "Schakel wifi in via de systeeminstellingen"

#: src/shell/corebridge.cpp:817
msgid "A hardware switch has turned the Wi-Fi radio off"
msgstr "Een hardwareschakelaar heeft de wifi-radio uitgeschakeld"

#: src/shell/corebridge.cpp:817
msgid "Use the Wi-Fi switch or key of this computer"
msgstr "Gebruik de wifi-schakelaar of -toets van deze computer"

#: src/shell/corebridge.cpp:821
msgid "There are several Wi-Fi adapters; the first one is used"
msgstr "Er zijn meerdere wifi-adapters; de eerste wordt gebruikt"

#: src/shell/corebridge.cpp:821
msgid "If transfers fail, turn off the adapters you do not need"
msgstr "Als overdrachten mislukken, schakel dan de adapters uit die je niet nodig hebt"

#: src/shell/corebridge.cpp:824
msgid "No Wi-Fi adapter was found"
msgstr "Er is geen wifi-adapter gevonden"

#: src/shell/corebridge.cpp:824
msgid ""
"Plug in a Wi-Fi adapter, or check that the driver of the built-in one is "
"loaded"
msgstr "Sluit een wifi-adapter aan, of controleer of het stuurprogramma van de ingebouwde adapter is geladen"

#: src/shell/corebridge.cpp:828
msgid "NetworkManager does not manage the Wi-Fi adapter"
msgstr "NetworkManager beheert de wifi-adapter niet"

#: src/shell/corebridge.cpp:828
msgid ""
"Let NetworkManager manage it: another network tool or an unmanaged-devices "
"setting may be holding it"
msgstr "Laat NetworkManager hem beheren: een ander netwerkprogramma of een instelling voor niet-beheerde apparaten kan hem vasthouden"

#: src/shell/corebridge.cpp:832
msgid "The Wi-Fi adapter needs firmware that is not installed"
msgstr "De wifi-adapter heeft firmware nodig die niet is geïnstalleerd"

#: src/shell/corebridge.cpp:832
msgid ""
"Install the firmware package for the adapter (often linux-firmware), then "
"restart the computer"
msgstr "Installeer het firmwarepakket voor de adapter (vaak linux-firmware) en start daarna de computer opnieuw"

#: src/shell/corebridge.cpp:836
msgid "The NetworkManager plugin for the Wi-Fi adapter is missing"
msgstr "De NetworkManager-plug-in voor de wifi-adapter ontbreekt"

#: src/shell/corebridge.cpp:836
msgid ""
"Install the NetworkManager Wi-Fi plugin package of your distribution, then "
"restart NetworkManager"
msgstr "Installeer het pakket van de NetworkManager-wifi-plug-in van je distributie en start daarna NetworkManager opnieuw"

#: src/shell/corebridge.cpp:839
msgid "NetworkManager reports the Wi-Fi adapter as unavailable"
msgstr "NetworkManager meldt dat de wifi-adapter niet beschikbaar is"

#: src/shell/corebridge.cpp:839
msgid "Check that its driver loaded and its radio is on"
msgstr "Controleer of het stuurprogramma is geladen en de radio is ingeschakeld"

#: src/shell/corebridge.cpp:843
msgid "NetworkManager asks for authentication to control the network"
msgstr "NetworkManager vraagt om authenticatie om het netwerk te beheren"

#: src/shell/corebridge.cpp:843
msgid ""
"The hotspot may prompt for a password or be refused; allow network control "
"for your user in the PolicyKit settings"
msgstr "De hotspot vraagt mogelijk om een wachtwoord of wordt geweigerd; sta netwerkbeheer voor je gebruiker toe in de PolicyKit-instellingen"

#: src/shell/corebridge.cpp:846
msgid "NetworkManager does not allow this user to control the network"
msgstr "NetworkManager staat deze gebruiker niet toe het netwerk te beheren"

#: src/shell/corebridge.cpp:846
msgid ""
"Ask the administrator to allow network control and changes to system "
"connections for your user"
msgstr "Vraag de beheerder om je gebruiker toestemming te geven het netwerk te beheren en systeemverbindingen te wijzigen"

#: src/shell/corebridge.cpp:850
msgid "Joining Wi-Fi cannot work: something it needs is blocked"
msgstr "Verbinden met wifi kan niet werken: iets wat het nodig heeft, is geblokkeerd"

#: src/shell/corebridge.cpp:850
msgid "Fix the blocked items of NetworkManager and the Wi-Fi adapter"
msgstr "Los de geblokkeerde onderdelen van NetworkManager en de wifi-adapter op"

#: src/shell/corebridge.cpp:853
msgid ""
"It is not known whether joining Wi-Fi works: something it needs could not be "
"checked"
msgstr "Het is onbekend of verbinden met wifi werkt: iets wat het nodig heeft, kon niet worden gecontroleerd"

#: src/shell/corebridge.cpp:853
msgid "Refresh when the items above are sorted out"
msgstr "Vernieuw wanneer de onderdelen hierboven zijn opgelost"

#: src/shell/corebridge.cpp:856 src/shell/corebridge.cpp:878
msgid "The sandbox has no network access"
msgstr "De sandbox heeft geen netwerktoegang"

#: src/shell/corebridge.cpp:856 src/shell/corebridge.cpp:878
msgid "Allow the network for the Flatpak"
msgstr "Sta het netwerk toe voor de Flatpak"

#: src/shell/corebridge.cpp:860
msgid "The Wi-Fi adapter cannot create a hotspot"
msgstr "De wifi-adapter kan geen hotspot maken"

#: src/shell/corebridge.cpp:860
msgid ""
"Receiving by Wi-Fi needs an adapter with access point mode; Bluetooth still "
"works"
msgstr "Ontvangen via wifi vereist een adapter met access-pointmodus; Bluetooth werkt nog steeds"

#: src/shell/corebridge.cpp:863
msgid "The Wi-Fi adapter cannot protect a hotspot with WPA2"
msgstr "De wifi-adapter kan een hotspot niet met WPA2 beveiligen"

#: src/shell/corebridge.cpp:863
msgid "Receiving by Wi-Fi needs WPA2 on the adapter; Bluetooth still works"
msgstr "Ontvangen via wifi vereist WPA2 op de adapter; Bluetooth werkt nog steeds"

#: src/shell/corebridge.cpp:866
msgid "The Wi-Fi adapter reports no 2.4 GHz or 5 GHz band for a hotspot"
msgstr "De wifi-adapter meldt geen 2,4 GHz- of 5 GHz-band voor een hotspot"

#: src/shell/corebridge.cpp:866
msgid "Receiving by Wi-Fi needs one of them; Bluetooth still works"
msgstr "Ontvangen via wifi vereist één van die twee; Bluetooth werkt nog steeds"

#: src/shell/corebridge.cpp:869
msgid "The Wi-Fi driver does not report what the adapter can do"
msgstr "Het wifi-stuurprogramma meldt niet wat de adapter kan"

#: src/shell/corebridge.cpp:869
msgid "The hotspot may still work; it could not be checked"
msgstr "De hotspot kan nog werken; dit kon niet worden gecontroleerd"

#: src/shell/corebridge.cpp:872
msgid "NetworkManager asks for authentication to share a connection"
msgstr "NetworkManager vraagt om authenticatie om een verbinding te delen"

#: src/shell/corebridge.cpp:872
msgid ""
"The hotspot may prompt for a password or be refused; allow it in the "
"PolicyKit settings"
msgstr "De hotspot vraagt mogelijk om een wachtwoord of wordt geweigerd; sta dit toe in de PolicyKit-instellingen"

#: src/shell/corebridge.cpp:875
msgid "This user may not share a connection"
msgstr "Deze gebruiker mag geen verbinding delen"

#: src/shell/corebridge.cpp:875
msgid "Ask the administrator to allow sharing connections in NetworkManager"
msgstr "Vraag de beheerder om het delen van verbindingen in NetworkManager toe te staan"

#: src/shell/corebridge.cpp:882
msgid "dnsmasq is installed"
msgstr "dnsmasq is geïnstalleerd"

#: src/shell/corebridge.cpp:885
msgid "The hotspot already handed out addresses in this session"
msgstr "De hotspot heeft in deze sessie al adressen uitgedeeld"

#: src/shell/corebridge.cpp:888
msgid "dnsmasq was not found"
msgstr "dnsmasq is niet gevonden"

#: src/shell/corebridge.cpp:888
msgid ""
"The hotspot hands out addresses with dnsmasq; install the dnsmasq or dnsmasq-"
"base package"
msgstr "De hotspot deelt adressen uit met dnsmasq; installeer het pakket dnsmasq of dnsmasq-base"

#: src/shell/corebridge.cpp:891
msgid "dnsmasq cannot be looked for from inside the sandbox"
msgstr "dnsmasq kan vanuit de sandbox niet worden gezocht"

#: src/shell/corebridge.cpp:891
msgid ""
"If the hotspot gets no addresses, install dnsmasq or dnsmasq-base on this "
"computer"
msgstr "Als de hotspot geen adressen krijgt, installeer dan dnsmasq of dnsmasq-base op deze computer"

#: src/shell/corebridge.cpp:894
msgid "The hotspot could not start its address service"
msgstr "De hotspot kon zijn adresservice niet starten"

#: src/shell/corebridge.cpp:894
msgid "Install the dnsmasq or dnsmasq-base package"
msgstr "Installeer het pakket dnsmasq of dnsmasq-base"

#: src/shell/corebridge.cpp:898
msgid "The firewall service (firewalld) is not running"
msgstr "De firewallservice (firewalld) draait niet"

#: src/shell/corebridge.cpp:898
msgid ""
"KuickShare cannot open the hotspot port by itself; it asks you before the "
"hotspot uses an open zone"
msgstr "KuickShare kan de hotspotpoort niet zelf openen; het vraagt je eerst of de hotspot een open zone mag gebruiken"

#: src/shell/corebridge.cpp:901
msgid "The sandbox hides the firewall service"
msgstr "De sandbox verbergt de firewallservice"

#: src/shell/corebridge.cpp:901
msgid "Allow the sandbox to talk to firewalld, then restart KuickShare"
msgstr "Sta de sandbox toe om met firewalld te communiceren en start KuickShare daarna opnieuw"

#: src/shell/corebridge.cpp:904
msgid "The firewall has no zone for the hotspot (nm-shared)"
msgstr "De firewall heeft geen zone voor de hotspot (nm-shared)"

#: src/shell/corebridge.cpp:904
msgid "The hotspot may be blocked or open; add the zone or check its rules"
msgstr "De hotspot kan worden geblokkeerd of open zijn; voeg de zone toe of controleer de regels"

#: src/shell/corebridge.cpp:907
msgid "Changing the firewall asks for authentication"
msgstr "Het wijzigen van de firewall vraagt om authenticatie"

#: src/shell/corebridge.cpp:907
msgid "Opening the hotspot port may prompt for a password or be refused"
msgstr "Het openen van de hotspotpoort vraagt mogelijk om een wachtwoord of wordt geweigerd"

#: src/shell/corebridge.cpp:910
msgid "This user may not change the firewall"
msgstr "Deze gebruiker mag de firewall niet wijzigen"

#: src/shell/corebridge.cpp:910
msgid "The hotspot port cannot be opened; ask the administrator to allow it"
msgstr "De hotspotpoort kan niet worden geopend; vraag de beheerder om dat toe te staan"

#: src/shell/corebridge.cpp:913
msgid "It cannot be checked whether this user may change the firewall"
msgstr "Er kan niet worden gecontroleerd of deze gebruiker de firewall mag wijzigen"

#: src/shell/corebridge.cpp:913
msgid "A sandbox cannot ask for this; the hotspot is tried anyway"
msgstr "Een sandbox kan hier niet om vragen; de hotspot wordt toch geprobeerd"

#: src/shell/corebridge.cpp:916
msgid "The firewall refused the hotspot in this session"
msgstr "De firewall heeft de hotspot in deze sessie geweigerd"

#: src/shell/corebridge.cpp:916
msgid ""
"Allow the hotspot in the firewall, or let it use an open zone when asked"
msgstr "Sta de hotspot toe in de firewall, of laat hem een open zone gebruiken wanneer daarom wordt gevraagd"

#: src/shell/corebridge.cpp:919
msgid "You allowed the hotspot to use an open firewall zone in this session"
msgstr "Je hebt de hotspot in deze sessie toegestaan een open firewallzone te gebruiken"

#: src/shell/corebridge.cpp:919
msgid "Turning the setting off takes this back"
msgstr "Door de instelling uit te schakelen, wordt dit ingetrokken"

#: src/shell/corebridge.cpp:923
msgid "The Flatpak lacks permissions it needs"
msgstr "De Flatpak mist rechten die nodig zijn"

#: src/shell/corebridge.cpp:923
msgid "Allow the permissions named in the details with flatpak override"
msgstr "Sta de rechten die in de details worden genoemd toe met flatpak override"

#: src/shell/corebridge.cpp:926
msgid "The Flatpak can see the whole file system"
msgstr "De Flatpak kan het hele bestandssysteem zien"

#: src/shell/corebridge.cpp:926
msgid "It does not need to; take that permission away"
msgstr "Dat is niet nodig; haal dat recht weg"

#: src/shell/corebridge.cpp:930
msgid "No more information is available"
msgstr "Er is geen verdere informatie beschikbaar"

#: src/shell/corebridge.cpp:937 src/shell/qml/SendPage.qml:224
msgid "Ready"
msgstr "Gereed"

#: src/shell/corebridge.cpp:939
msgid "Warning"
msgstr "Waarschuwing"

#: src/shell/corebridge.cpp:941
msgid "Blocked"
msgstr "Geblokkeerd"

#: src/shell/corebridge.cpp:943
msgid "Checking"
msgstr "Bezig met controleren"

#: src/shell/corebridge.cpp:947 src/shell/corebridge.cpp:979
msgid "Unknown"
msgstr "Onbekend"

#: src/shell/corebridge.cpp:971
msgid "Available"
msgstr "Beschikbaar"

#: src/shell/corebridge.cpp:973
msgid "Limited"
msgstr "Beperkt"

#: src/shell/corebridge.cpp:975
msgid "Unavailable"
msgstr "Niet beschikbaar"

#: src/shell/corebridge.cpp:1008
msgid "sending"
msgstr "versturen"

#: src/shell/corebridge.cpp:1011
msgid "receiving"
msgstr "ontvangen"

#: src/shell/corebridge.cpp:1014
msgid "joining networks"
msgstr "verbinden met netwerken"

