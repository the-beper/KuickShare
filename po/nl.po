#: src/core/desktop.rs:90 src/core/desktop.rs:1252 src/shell/corebridge.cpp:762
msgid ""
"The offer has too many files. Ask the sender to send fewer files at once"
msgstr ""
"Het aanbod bevat te veel bestanden. Vraag de afzender om minder bestanden "
"tegelijk te sturen"

#: src/core/desktop.rs:94 src/core/desktop.rs:1257 src/shell/corebridge.cpp:766
msgid ""
"There is not enough free space in the download folder. Free some space or "
"choose another download folder in Preferences"
msgstr ""
"Er is niet genoeg vrije ruimte in de downloadmap. Maak ruimte vrij of kies "
"een andere downloadmap in de instellingen"

#: src/core/desktop.rs:98 src/core/desktop.rs:1263 src/shell/corebridge.cpp:770
msgid ""
"The download folder cannot be used. Choose another download folder in "
"Preferences"
msgstr ""
"De downloadmap kan niet worden gebruikt. Kies een andere downloadmap in de "
"instellingen"

#: src/core/desktop.rs:101 src/core/desktop.rs:1269
#: src/shell/corebridge.cpp:774
msgid ""
"A file name in the offer cannot be saved. Ask the sender to rename the file "
"and send it again"
msgstr ""
"Een bestandsnaam in het aanbod kan niet worden opgeslagen. Vraag de afzender "
"de bestandsnaam te wijzigen en het bestand opnieuw te sturen"

#: src/core/desktop.rs:104 src/core/desktop.rs:1274 src/core/desktop.rs:1278
#: src/shell/corebridge.cpp:778
msgid "The offer is malformed. Ask the sender to try again"
msgstr "Het aanbod is ongeldig. Vraag de afzender het opnieuw te proberen"

#: src/core/desktop.rs:110 src/core/desktop.rs:1283
#: src/shell/corebridge.cpp:781
msgid ""
"The offer was refused for an unknown reason. Ask the sender to try again"
msgstr ""
"Het aanbod is om een onbekende reden geweigerd. Vraag de afzender het "
"opnieuw te proberen"

#: src/core/notify.rs:182
msgid "A nearby device"
msgstr "Een apparaat in de buurt"

#: src/core/notify.rs:184
msgid "%1 wants to share with you"
msgstr "%1 wil iets met je delen"

#: src/core/notify.rs:187
msgid ""
"%1 wants to share with you\n"
"PIN: %2"
msgstr ""
"%1 wil iets met je delen\n"
"PIN: %2"

#: src/core/notify.rs:192
msgid ""
"“Accept and Trust” recognises this device by its name and network address, "
"which another device on the same network can copy"
msgstr ""
"“Goedkeuren en vertrouwen” herkent dit apparaat aan de naam en het "
"netwerkadres; een ander apparaat op hetzelfde netwerk kan die kopiëren"

#: src/core/notify.rs:196
msgctxt "@action:button"
msgid "Accept"
msgstr "Goedkeuren"

#: src/core/notify.rs:200
msgctxt "@action:button"
msgid "Accept and Trust"
msgstr "Goedkeuren en vertrouwen"

#: src/core/notify.rs:203
msgctxt "@action:button"
msgid "Decline"
msgstr "Afwijzen"

#: src/core/notify.rs:207
msgctxt "@title:notification"
msgid "Incoming Transfer"
msgstr "Inkomende overdracht"

#: src/core/notify.rs:218 src/core/notify.rs:243 src/core/notify.rs:280
#: src/core/notify.rs:290 src/core/notify.rs:319
msgid "a nearby device"
msgstr "een apparaat in de buurt"

#: src/core/notify.rs:221
msgctxt "@action:button"
msgid "Copy Link"
msgstr "Link kopiëren"

#: src/core/notify.rs:223
msgctxt "@action:button"
msgid "Copy Text"
msgstr "Tekst kopiëren"

#: src/core/notify.rs:226
msgctxt "@action:button"
msgid "Open Link"
msgstr "Link openen"

#: src/core/notify.rs:228
msgctxt "@action:button"
msgid "View"
msgstr "Bekijken"

#: src/core/notify.rs:233
msgctxt "@title:notification"
msgid "Link Received"
msgstr "Link ontvangen"

#: src/core/notify.rs:235
msgctxt "@title:notification"
msgid "Text Received"
msgstr "Tekst ontvangen"

#: src/core/notify.rs:237
msgid ""
"From %1:\n"
"%2"
msgstr ""
"Van %1:\n"
"%2"

#: src/core/notify.rs:246
msgctxt "@action:button"
msgid "Open File"
msgstr "Bestand openen"

#: src/core/notify.rs:248
msgctxt "@action:button"
msgid "Open Folder"
msgstr "Map openen"

#: src/core/notify.rs:252
msgctxt "@title:notification"
msgid "Files Received"
msgstr "Bestanden ontvangen"

#: src/core/notify.rs:253
msgid "From %1"
msgstr "Van %1"

#: src/core/notify.rs:261
msgctxt "@title:notification"
msgid "Wi-Fi Network Joined"
msgstr "Wi-Fi-netwerk verbonden"

#: src/core/notify.rs:262 src/shell/qml/Main.qml:203
msgid "Connected to %1"
msgstr "Verbonden met %1"

#: src/core/notify.rs:269
msgctxt "@title:notification"
msgid "Could Not Join Wi-Fi"
msgstr "Kan geen verbinding maken met Wi-Fi"

#: src/core/notify.rs:270
msgid ""
"Could not connect to %1\n"
"%2"
msgstr ""
"Kan geen verbinding maken met %1\n"
"%2"

#: src/core/notify.rs:277
msgctxt "@title:notification"
msgid "Offer Refused"
msgstr "Verzoek geweigerd"

#: src/core/notify.rs:279
msgid "From %1: %2"
msgstr "Van %1: %2"

#: src/core/notify.rs:293
msgid ""
"Could not start the transfer to %1 over Bluetooth\n"
"Check that Bluetooth is on and the device is nearby, then try again"
msgstr ""
"Kan de overdracht naar %1 via Bluetooth niet starten\n"
"Controleer of Bluetooth aan staat en het apparaat in de buurt is, en probeer "
"het daarna opnieuw"

#: src/core/notify.rs:299
msgid ""
"%1 declined the transfer or could not receive it\n"
"Check the other device and its free space, then try again"
msgstr ""
"%1 heeft de overdracht geweigerd of kon deze niet ontvangen\n"
"Controleer het andere apparaat en de vrije ruimte, en probeer het daarna "
"opnieuw"

#: src/core/notify.rs:307
msgctxt "@title:notification"
msgid "Transfer Not Accepted"
msgstr "Overdracht niet geaccepteerd"

#: src/core/notify.rs:316
msgctxt "@title:notification"
msgid "Transfer Interrupted"
msgstr "Overdracht onderbroken"

#: src/core/notify.rs:318
msgid ""
"The connection with %1 was lost\n"
"Keep both devices close and awake, then try again"
msgstr ""
"De verbinding met %1 is verbroken\n"
"Hou beide apparaten dicht bij elkaar en wakker, en probeer het daarna opnieuw"

#: src/core/tray.rs:128
msgctxt "@info:tooltip"
msgid "Visible for %1 more minute"
msgid_plural "Visible for %1 more minutes"
msgstr[0] "Nog %1 minuut zichtbaar"
msgstr[1] "Nog %1 minuten zichtbaar"

#: src/core/tray.rs:160
msgctxt "@action:inmenu"
msgid "Open KuickShare"
msgstr "KuickShare openen"

#: src/core/tray.rs:167
msgctxt "@action:inmenu"
msgid "Send Files…"
msgstr "Bestanden versturen…"

#: src/core/tray.rs:173
msgctxt "@action:inmenu"
msgid "Send Clipboard…"
msgstr "Klembord versturen…"

#: src/core/tray.rs:180
msgctxt "@action:inmenu"
msgid "Visible to nearby devices"
msgstr "Zichtbaar voor apparaten in de buurt"

#: src/core/tray.rs:187
msgctxt "@action:inmenu"
msgid "Visible for 10 minutes"
msgstr "Zichtbaar gedurende 10 minuten"

#: src/core/tray.rs:195 src/shell/qml/Main.qml:37 src/shell/qml/Main.qml:453
msgctxt "@action:inmenu"
msgid "Preferences"
msgstr "Instellingen"

#: src/core/tray.rs:201
msgctxt "@action:inmenu"
msgid "Quit"
msgstr "Afsluiten"

#: src/shell/corebridge.cpp:92
msgid "The sharing service is not responding. Restart KuickShare and try again"
msgstr ""
"De deelservice reageert niet. Herstart KuickShare en probeer het opnieuw"

#: src/shell/corebridge.cpp:94
msgid "The sharing service is not running. Restart KuickShare and try again"
msgstr "De deelservice draait niet. Herstart KuickShare en probeer het opnieuw"

#: src/shell/corebridge.cpp:98
msgid ""
"Something went wrong. Try again, and look in the log if it keeps happening"
msgstr ""
"Er ging iets mis. Probeer het opnieuw en kijk in het logboek als het blijft "
"gebeuren"

#: src/shell/corebridge.cpp:740
msgid "This transfer is no longer waiting for an answer"
msgstr "Deze overdracht wacht niet meer op een antwoord"

#: src/shell/corebridge.cpp:747
msgid "This device cannot be trusted: its network address is not known"
msgstr "Dit apparaat kan niet worden vertrouwd: het netwerkadres is onbekend"

#: src/shell/corebridge.cpp:749
msgid "This device cannot be trusted: it sent no name"
msgstr "Dit apparaat kan niet worden vertrouwd: het heeft geen naam verstuurd"

#: src/shell/corebridge.cpp:751
msgid ""
"This device cannot be trusted: its network address now belongs to another "
"device"
msgstr ""
"Dit apparaat kan niet worden vertrouwd: het netwerkadres hoort nu bij een "
"ander apparaat"

#: src/shell/corebridge.cpp:816
msgid "Bluetooth (BlueZ)"
msgstr "Bluetooth (BlueZ)"

#: src/shell/corebridge.cpp:819
msgid "NetworkManager"
msgstr "NetworkManager"

#: src/shell/corebridge.cpp:822
msgid "Wi-Fi adapter"
msgstr "Wifi-adapter"

#: src/shell/corebridge.cpp:825
msgid "Hotspot addresses (dnsmasq)"
msgstr "Adressen van de hotspot (dnsmasq)"

#: src/shell/corebridge.cpp:828
msgid "Firewall (firewalld)"
msgstr "Firewall (firewalld)"

#: src/shell/corebridge.cpp:831
msgid "Flatpak permissions"
msgstr "Flatpak-rechten"

#: src/shell/corebridge.cpp:846
msgid "The check took too long"
msgstr "De controle duurde te lang"

#: src/shell/corebridge.cpp:846
msgid ""
"Refresh to check again; if it keeps happening, the service it asks may be "
"busy or stuck"
msgstr ""
"Vernieuw om opnieuw te controleren; als dit blijft gebeuren, is de service "
"die wordt bevraagd mogelijk bezet of vastgelopen"

#: src/shell/corebridge.cpp:849
msgid "The system message bus could not be reached"
msgstr "De systeemberichtenbus kon niet worden bereikt"

#: src/shell/corebridge.cpp:849
msgid "The check needs the system D-Bus; refresh to try again"
msgstr ""
"De controle heeft de systeem-D-Bus nodig; vernieuw om het opnieuw te proberen"

#: src/shell/corebridge.cpp:852
msgid "The service gave an answer that could not be understood"
msgstr "De service gaf een antwoord dat niet begrepen kon worden"

#: src/shell/corebridge.cpp:852
msgid "Refresh to try again; if it persists, update the service"
msgstr ""
"Vernieuw om het opnieuw te proberen; blijft het probleem bestaan, werk dan "
"de service bij"

#: src/shell/corebridge.cpp:855
msgid "The check failed"
msgstr "De controle is mislukt"

#: src/shell/corebridge.cpp:855
msgid "Refresh to try again"
msgstr "Vernieuw om het opnieuw te proberen"

#: src/shell/corebridge.cpp:858
msgid "Not checked, because something it depends on is not ready"
msgstr "Niet gecontroleerd, omdat iets waarvan het afhangt nog niet klaar is"

#: src/shell/corebridge.cpp:858
msgid "Fix the items that are blocked or unknown first"
msgstr "Los eerst de onderdelen op die geblokkeerd of onbekend zijn"

#: src/shell/corebridge.cpp:863
msgid "The Bluetooth service is not running"
msgstr "De Bluetooth-service draait niet"

#: src/shell/corebridge.cpp:863
msgid ""
"Start the Bluetooth service; if BlueZ is not installed, install it first"
msgstr ""
"Start de Bluetooth-service; is BlueZ niet geïnstalleerd, installeer het dan "
"eerst"

#: src/shell/corebridge.cpp:866
msgid "The Bluetooth service is installed but not running"
msgstr "De Bluetooth-service is geïnstalleerd maar draait niet"

#: src/shell/corebridge.cpp:866 src/shell/corebridge.cpp:919
msgid "It starts when something needs it; to start it now, use the command"
msgstr ""
"Hij start wanneer iets hem nodig heeft; om hem nu te starten, gebruik de "
"opdracht"

#: src/shell/corebridge.cpp:869
msgid "The sandbox hides the Bluetooth service"
msgstr "De sandbox verbergt de Bluetooth-service"

#: src/shell/corebridge.cpp:869
msgid "Allow the sandbox to talk to BlueZ, then restart KuickShare"
msgstr ""
"Sta de sandbox toe om met BlueZ te communiceren en start KuickShare daarna "
"opnieuw"

#: src/shell/corebridge.cpp:873
msgid "No Bluetooth adapter was found"
msgstr "Er is geen Bluetooth-adapter gevonden"

#: src/shell/corebridge.cpp:873
msgid ""
"Plug in or enable a Bluetooth adapter; if one is installed, check that its "
"driver is loaded"
msgstr ""
"Sluit een Bluetooth-adapter aan of schakel er een in; is er al een "
"geïnstalleerd, controleer dan of het stuurprogramma is geladen"

#: src/shell/corebridge.cpp:877
msgid "The Bluetooth adapter is turned off"
msgstr "De Bluetooth-adapter is uitgeschakeld"

#: src/shell/corebridge.cpp:877
msgid ""
"KuickShare turns it on when it needs it; you can also turn Bluetooth on in "
"the system settings"
msgstr ""
"KuickShare schakelt hem in wanneer dat nodig is; je kunt Bluetooth ook "
"inschakelen in de systeeminstellingen"

#: src/shell/corebridge.cpp:880
msgid "Blocked by a radio switch"
msgstr "Geblokkeerd door een radioschakelaar"

#: src/shell/corebridge.cpp:880
msgid "Turn Bluetooth on in the system settings"
msgstr "Schakel Bluetooth in via de systeeminstellingen"

#: src/shell/corebridge.cpp:884
msgid "The Bluetooth adapter does not support Bluetooth Low Energy"
msgstr "De Bluetooth-adapter ondersteunt Bluetooth Low Energy niet"

#: src/shell/corebridge.cpp:884
msgid "Use an adapter that supports Bluetooth 4.0 or newer"
msgstr "Gebruik een adapter die Bluetooth 4.0 of nieuwer ondersteunt"

#: src/shell/corebridge.cpp:887
msgid "BlueZ does not report what the adapter can do"
msgstr "BlueZ meldt niet wat de adapter kan"

#: src/shell/corebridge.cpp:887 src/shell/corebridge.cpp:901
msgid "This may still work; a newer BlueZ reports it"
msgstr "Het kan nog werken; een nieuwere BlueZ meldt dit"

#: src/shell/corebridge.cpp:891
msgid "The Bluetooth adapter cannot advertise"
msgstr "De Bluetooth-adapter ondersteunt geen advertising"

#: src/shell/corebridge.cpp:891
msgid ""
"Receiving by Bluetooth needs an adapter that can advertise; sending is not "
"affected"
msgstr ""
"Ontvangen via Bluetooth vereist een adapter die advertising ondersteunt; "
"versturen wordt niet beïnvloed"

#: src/shell/corebridge.cpp:894
msgid "The adapter has no free advertising slot now"
msgstr "De adapter heeft nu geen vrij advertising-slot"

#: src/shell/corebridge.cpp:894
msgid "Another program uses them; close it and refresh"
msgstr "Een ander programma gebruikt ze; sluit het af en vernieuw"

#: src/shell/corebridge.cpp:898
msgid "The Bluetooth adapter cannot scan for devices"
msgstr "De Bluetooth-adapter kan niet naar apparaten zoeken"

#: src/shell/corebridge.cpp:898
msgid "Sending needs an adapter that can scan; use another one"
msgstr "Versturen vereist een adapter die kan zoeken; gebruik een andere"

#: src/shell/corebridge.cpp:901
msgid "BlueZ does not report how the adapter can scan"
msgstr "BlueZ meldt niet hoe de adapter kan zoeken"

#: src/shell/corebridge.cpp:905
msgid "BlueZ offers no GATT services"
msgstr "BlueZ biedt geen GATT-services"

#: src/shell/corebridge.cpp:905
msgid "Update BlueZ to a version with GATT support"
msgstr "Werk BlueZ bij naar een versie met GATT-ondersteuning"

#: src/shell/corebridge.cpp:909
msgid "The sandbox does not allow Bluetooth sockets"
msgstr "De sandbox staat geen Bluetooth-sockets toe"

#: src/shell/corebridge.cpp:909
msgid ""
"Transfers still work over a slower path; allow Bluetooth for the Flatpak to "
"use the faster one"
msgstr ""
"Overdrachten werken nog steeds via een tragere route; sta de Flatpak toe "
"Bluetooth te gebruiken voor de snellere route"

#: src/shell/corebridge.cpp:912
msgid "The kernel does not report Bluetooth socket support"
msgstr "De kernel meldt geen ondersteuning voor Bluetooth-sockets"

#: src/shell/corebridge.cpp:912
msgid "Transfers still work over a slower path if it is missing"
msgstr "Overdrachten werken nog steeds via een tragere route als die ontbreekt"

#: src/shell/corebridge.cpp:916
msgid "NetworkManager is not running"
msgstr "NetworkManager draait niet"

#: src/shell/corebridge.cpp:916
msgid ""
"Wi-Fi Direct needs NetworkManager; start it, or install it if this system "
"uses another network tool"
msgstr ""
"Wi-Fi Direct heeft NetworkManager nodig; start het, of installeer het als "
"dit systeem een ander netwerkprogramma gebruikt"

#: src/shell/corebridge.cpp:919
msgid "NetworkManager is installed but not running"
msgstr "NetworkManager is geïnstalleerd maar draait niet"

#: src/shell/corebridge.cpp:922
msgid "The sandbox hides NetworkManager"
msgstr "De sandbox verbergt NetworkManager"

#: src/shell/corebridge.cpp:922
msgid "Allow the sandbox to talk to NetworkManager, then restart KuickShare"
msgstr ""
"Sta de sandbox toe om met NetworkManager te communiceren en start KuickShare "
"daarna opnieuw"

#: src/shell/corebridge.cpp:926
msgid "Networking is turned off in NetworkManager"
msgstr "Netwerken is uitgeschakeld in NetworkManager"

#: src/shell/corebridge.cpp:926
msgid "Turn networking on in the network settings"
msgstr "Schakel netwerken in via de netwerkinstellingen"

#: src/shell/corebridge.cpp:930
msgid "Wi-Fi is turned off"
msgstr "Wifi is uitgeschakeld"

#: src/shell/corebridge.cpp:930
msgid "Turn Wi-Fi on in the system settings"
msgstr "Schakel wifi in via de systeeminstellingen"

#: src/shell/corebridge.cpp:934
msgid "A hardware switch has turned the Wi-Fi radio off"
msgstr "Een hardwareschakelaar heeft de wifi-radio uitgeschakeld"

#: src/shell/corebridge.cpp:934
msgid "Use the Wi-Fi switch or key of this system"
msgstr "Gebruik de wifi-schakelaar of -toets van dit systeem"

#: src/shell/corebridge.cpp:938
msgid "There are several Wi-Fi adapters; the first one is used"
msgstr "Er zijn meerdere wifi-adapters; de eerste wordt gebruikt"

#: src/shell/corebridge.cpp:938
msgid "If transfers fail, turn off the adapters you do not need"
msgstr ""
"Als overdrachten mislukken, schakel dan de adapters uit die je niet nodig "
"hebt"

#: src/shell/corebridge.cpp:941
msgid "No Wi-Fi adapter was found"
msgstr "Er is geen wifi-adapter gevonden"

#: src/shell/corebridge.cpp:941
msgid ""
"Plug in a Wi-Fi adapter, or check that the driver of the built-in one is "
"loaded"
msgstr ""
"Sluit een wifi-adapter aan, of controleer of het stuurprogramma van de "
"ingebouwde adapter is geladen"

#: src/shell/corebridge.cpp:945
msgid "NetworkManager does not manage the Wi-Fi adapter"
msgstr "NetworkManager beheert de wifi-adapter niet"

#: src/shell/corebridge.cpp:945
msgid ""
"Let NetworkManager manage it: another network tool or an unmanaged-devices "
"setting may be holding it"
msgstr ""
"Laat NetworkManager hem beheren: een ander netwerkprogramma of een "
"instelling voor niet-beheerde apparaten kan hem vasthouden"

#: src/shell/corebridge.cpp:949
msgid "The Wi-Fi adapter needs firmware that is not installed"
msgstr "De wifi-adapter heeft firmware nodig die niet is geïnstalleerd"

#: src/shell/corebridge.cpp:949
msgid ""
"Install the firmware package for the adapter (often linux-firmware), then "
"restart this system"
msgstr ""
"Installeer het firmwarepakket voor de adapter (vaak linux-firmware) en start "
"daarna dit systeem opnieuw"

#: src/shell/corebridge.cpp:953
msgid "The NetworkManager plugin for the Wi-Fi adapter is missing"
msgstr "De NetworkManager-plug-in voor de wifi-adapter ontbreekt"

#: src/shell/corebridge.cpp:953
msgid ""
"Install the NetworkManager Wi-Fi plugin package of your distribution, then "
"restart NetworkManager"
msgstr ""
"Installeer het pakket van de NetworkManager-wifi-plug-in van je distributie "
"en start daarna NetworkManager opnieuw"

#: src/shell/corebridge.cpp:956
msgid "NetworkManager reports the Wi-Fi adapter as unavailable"
msgstr "NetworkManager meldt dat de wifi-adapter niet beschikbaar is"

#: src/shell/corebridge.cpp:956
msgid "Check that its driver loaded and its radio is on"
msgstr ""
"Controleer of het stuurprogramma is geladen en de radio is ingeschakeld"

#: src/shell/corebridge.cpp:960
msgid "NetworkManager asks for authentication to control the network"
msgstr "NetworkManager vraagt om authenticatie om het netwerk te beheren"

#: src/shell/corebridge.cpp:960
msgid ""
"The hotspot may prompt for a password or be refused; allow network control "
"for your user in the PolicyKit settings"
msgstr ""
"De hotspot vraagt mogelijk om een wachtwoord of wordt geweigerd; sta "
"netwerkbeheer voor je gebruiker toe in de PolicyKit-instellingen"

#: src/shell/corebridge.cpp:963
msgid "NetworkManager does not allow this user to control the network"
msgstr "NetworkManager staat deze gebruiker niet toe het netwerk te beheren"

#: src/shell/corebridge.cpp:963
msgid ""
"Ask the administrator to allow network control and changes to system "
"connections for your user"
msgstr ""
"Vraag de beheerder om je gebruiker toestemming te geven het netwerk te "
"beheren en systeemverbindingen te wijzigen"

#: src/shell/corebridge.cpp:967
msgid "Joining Wi-Fi cannot work: something it needs is blocked"
msgstr ""
"Verbinden met wifi kan niet werken: iets wat het nodig heeft, is geblokkeerd"

#: src/shell/corebridge.cpp:967
msgid "Fix the blocked items of NetworkManager and the Wi-Fi adapter"
msgstr ""
"Los de geblokkeerde onderdelen van NetworkManager en de wifi-adapter op"

#: src/shell/corebridge.cpp:970
msgid ""
"It is not known whether joining Wi-Fi works: something it needs could not be "
"checked"
msgstr ""
"Het is onbekend of verbinden met wifi werkt: iets wat het nodig heeft, kon "
"niet worden gecontroleerd"

#: src/shell/corebridge.cpp:970
msgid "Refresh when the items above are sorted out"
msgstr "Vernieuw wanneer de onderdelen hierboven zijn opgelost"

#: src/shell/corebridge.cpp:973 src/shell/corebridge.cpp:995
msgid "The sandbox has no network access"
msgstr "De sandbox heeft geen netwerktoegang"

#: src/shell/corebridge.cpp:973 src/shell/corebridge.cpp:995
msgid "Allow the network for the Flatpak"
msgstr "Sta het netwerk toe voor de Flatpak"

#: src/shell/corebridge.cpp:977
msgid "The Wi-Fi adapter cannot create a hotspot"
msgstr "De wifi-adapter kan geen hotspot maken"

#: src/shell/corebridge.cpp:977
msgid ""
"Receiving by Wi-Fi needs an adapter with access point mode; Bluetooth still "
"works"
msgstr ""
"Ontvangen via wifi vereist een adapter met access-pointmodus; Bluetooth "
"werkt nog steeds"

#: src/shell/corebridge.cpp:980
msgid "The Wi-Fi adapter cannot protect a hotspot with WPA2"
msgstr "De wifi-adapter kan een hotspot niet met WPA2 beveiligen"

#: src/shell/corebridge.cpp:980
msgid "Receiving by Wi-Fi needs WPA2 on the adapter; Bluetooth still works"
msgstr ""
"Ontvangen via wifi vereist WPA2 op de adapter; Bluetooth werkt nog steeds"

#: src/shell/corebridge.cpp:983
msgid "The Wi-Fi adapter reports no 2.4 GHz or 5 GHz band for a hotspot"
msgstr "De wifi-adapter meldt geen 2,4 GHz- of 5 GHz-band voor een hotspot"

#: src/shell/corebridge.cpp:983
msgid "Receiving by Wi-Fi needs one of them; Bluetooth still works"
msgstr ""
"Ontvangen via wifi vereist één van die twee; Bluetooth werkt nog steeds"

#: src/shell/corebridge.cpp:986
msgid "The Wi-Fi driver does not report what the adapter can do"
msgstr "Het wifi-stuurprogramma meldt niet wat de adapter kan"

#: src/shell/corebridge.cpp:986
msgid "The hotspot may still work; it could not be checked"
msgstr "De hotspot kan nog werken; dit kon niet worden gecontroleerd"

#: src/shell/corebridge.cpp:989
msgid "NetworkManager asks for authentication to share a connection"
msgstr "NetworkManager vraagt om authenticatie om een verbinding te delen"

#: src/shell/corebridge.cpp:989
msgid ""
"The hotspot may prompt for a password or be refused; allow it in the "
"PolicyKit settings"
msgstr ""
"De hotspot vraagt mogelijk om een wachtwoord of wordt geweigerd; sta dit toe "
"in de PolicyKit-instellingen"

#: src/shell/corebridge.cpp:992
msgid "This user may not share a connection"
msgstr "Deze gebruiker mag geen verbinding delen"

#: src/shell/corebridge.cpp:992
msgid "Ask the administrator to allow sharing connections in NetworkManager"
msgstr ""
"Vraag de beheerder om het delen van verbindingen in NetworkManager toe te "
"staan"

#: src/shell/corebridge.cpp:999
msgid "dnsmasq is installed"
msgstr "dnsmasq is geïnstalleerd"

#: src/shell/corebridge.cpp:1002
msgid "The hotspot already handed out addresses in this session"
msgstr "De hotspot heeft in deze sessie al adressen uitgedeeld"

#: src/shell/corebridge.cpp:1005
msgid "dnsmasq was not found"
msgstr "dnsmasq is niet gevonden"

#: src/shell/corebridge.cpp:1005
msgid ""
"The hotspot hands out addresses with dnsmasq; install the dnsmasq or dnsmasq-"
"base package"
msgstr ""
"De hotspot deelt adressen uit met dnsmasq; installeer het pakket dnsmasq of "
"dnsmasq-base"

#: src/shell/corebridge.cpp:1008
msgid "Checked when the first hotspot starts"
msgstr "Wordt gecontroleerd bij de start van de eerste hotspot"

#: src/shell/corebridge.cpp:1008
msgid "The sandbox cannot look for dnsmasq on this system"
msgstr "De sandbox kan dnsmasq op dit systeem niet zoeken"

#: src/shell/corebridge.cpp:1011
msgid "The hotspot could not start its address service"
msgstr "De hotspot kon zijn adresservice niet starten"

#: src/shell/corebridge.cpp:1011
msgid "Install the dnsmasq or dnsmasq-base package"
msgstr "Installeer het pakket dnsmasq of dnsmasq-base"

#: src/shell/corebridge.cpp:1015
msgid "The firewall service (firewalld) is not running"
msgstr "De firewallservice (firewalld) draait niet"

#: src/shell/corebridge.cpp:1015
msgid ""
"KuickShare cannot open the hotspot port by itself; it asks you before the "
"hotspot uses an open zone"
msgstr ""
"KuickShare kan de hotspotpoort niet zelf openen; het vraagt je eerst of de "
"hotspot een open zone mag gebruiken"

#: src/shell/corebridge.cpp:1018
msgid "The sandbox hides the firewall service"
msgstr "De sandbox verbergt de firewallservice"

#: src/shell/corebridge.cpp:1018
msgid "Allow the sandbox to talk to firewalld, then restart KuickShare"
msgstr ""
"Sta de sandbox toe om met firewalld te communiceren en start KuickShare "
"daarna opnieuw"

#: src/shell/corebridge.cpp:1021
msgid "The firewall has no zone for the hotspot (nm-shared)"
msgstr "De firewall heeft geen zone voor de hotspot (nm-shared)"

#: src/shell/corebridge.cpp:1021
msgid "The hotspot may be blocked or open; add the zone or check its rules"
msgstr ""
"De hotspot kan worden geblokkeerd of open zijn; voeg de zone toe of "
"controleer de regels"

#: src/shell/corebridge.cpp:1024
msgid "Changing the firewall asks for authentication"
msgstr "Het wijzigen van de firewall vraagt om authenticatie"

#: src/shell/corebridge.cpp:1024
msgid "Opening the hotspot port may prompt for a password or be refused"
msgstr ""
"Het openen van de hotspotpoort vraagt mogelijk om een wachtwoord of wordt "
"geweigerd"

#: src/shell/corebridge.cpp:1027
msgid "This user may not change the firewall"
msgstr "Deze gebruiker mag de firewall niet wijzigen"

#: src/shell/corebridge.cpp:1027
msgid "The hotspot port cannot be opened; ask the administrator to allow it"
msgstr ""
"De hotspotpoort kan niet worden geopend; vraag de beheerder om dat toe te "
