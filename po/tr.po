#: src/shell/corebridge.cpp:573
msgid "This transfer is no longer waiting for an answer"
msgstr "Bu paylaşım artık yanıt beklemiyor"

#: src/shell/corebridge.cpp:580
msgid "This device cannot be trusted: its network address is not known"
msgstr "Bu cihaza güvenilemiyor: ağ adresi bilinmiyor"

#: src/shell/corebridge.cpp:582
msgid "This device cannot be trusted: it sent no name"
msgstr "Bu cihaza güvenilemiyor: hiç isim göndermedi"

#: src/shell/corebridge.cpp:584
msgid ""
"This device cannot be trusted: its network address now belongs to another "
"device"
msgstr "Bu cihaza güvenilemiyor: ağ adresi artık başka bir cihaza ait"

#: src/shell/corebridge.cpp:595
msgid "The offer has too many files"
msgstr "Teklif çok fazla dosya içeriyor"

#: src/shell/corebridge.cpp:599
msgid "There is not enough free space in the download folder"
msgstr "İndirme klasöründe yeterli boş alan yok"

#: src/shell/corebridge.cpp:603
msgid "The download folder cannot be used"
msgstr "İndirme klasörü kullanılamıyor"

#: src/shell/corebridge.cpp:607
msgid "A file name in the offer cannot be saved"
msgstr "Teklifteki bir dosya adı kaydedilemiyor"

#: src/shell/corebridge.cpp:611
msgid "The offer is malformed"
msgstr "Teklif geçersiz"

#: src/shell/corebridge.cpp:614
msgid "The offer was refused"
msgstr "Teklif reddedildi"

#: src/shell/corebridge.cpp:649
msgid "Bluetooth (BlueZ)"
msgstr "Bluetooth (BlueZ)"

#: src/shell/corebridge.cpp:652
msgid "NetworkManager"
msgstr "NetworkManager"

#: src/shell/corebridge.cpp:655
msgid "Wi-Fi adapter"
msgstr "Wi-Fi adaptörü"

#: src/shell/corebridge.cpp:658
msgid "Hotspot addresses (dnsmasq)"
msgstr "Hotspot adresleri (dnsmasq)"

#: src/shell/corebridge.cpp:661
msgid "Firewall (firewalld)"
msgstr "Güvenlik duvarı (firewalld)"

#: src/shell/corebridge.cpp:664
msgid "Flatpak permissions"
msgstr "Flatpak izinleri"

#: src/shell/corebridge.cpp:679
msgid "The check took too long"
msgstr "Kontrol çok uzun sürdü"

#: src/shell/corebridge.cpp:679
msgid ""
"Refresh to check again; if it keeps happening, the service it asks may be "
"busy or stuck"
msgstr ""
"Yeniden kontrol etmek için yenileyin; bu durum sürerse, sorgulanan servis "
"meşgul ya da takılmış olabilir"

#: src/shell/corebridge.cpp:682
msgid "The system message bus could not be reached"
msgstr "Sistem mesaj veriyoluna ulaşılamadı"

#: src/shell/corebridge.cpp:682
msgid "The check needs the system D-Bus; refresh to try again"
msgstr "Kontrol sistem D-Bus’ını gerektiriyor; yeniden denemek için yenileyin"

#: src/shell/corebridge.cpp:685
msgid "The service gave an answer that could not be understood"
msgstr "Servis anlaşılamayan bir yanıt verdi"

#: src/shell/corebridge.cpp:685
msgid "Refresh to try again; if it persists, update the service"
msgstr "Yeniden denemek için yenileyin; sorun sürerse servisi güncelleyin"

#: src/shell/corebridge.cpp:688
msgid "The check failed"
msgstr "Kontrol başarısız oldu"

#: src/shell/corebridge.cpp:688
msgid "Refresh to try again"
msgstr "Yeniden denemek için yenileyin"

#: src/shell/corebridge.cpp:691
msgid "Not checked, because something it depends on is not ready"
msgstr "Bağlı olduğu bir şey hazır olmadığı için kontrol edilmedi"

#: src/shell/corebridge.cpp:691
msgid "Fix the items that are blocked or unknown first"
msgstr "Önce engellenen veya bilinmeyen öğeleri düzeltin"

#: src/shell/corebridge.cpp:696
msgid "The Bluetooth service is not running"
msgstr "Bluetooth servisi çalışmıyor"

#: src/shell/corebridge.cpp:696
msgid ""
"Start the Bluetooth service; if BlueZ is not installed, install it first"
msgstr "Bluetooth servisini başlatın; BlueZ kurulu değilse önce onu kurun"

#: src/shell/corebridge.cpp:699
msgid "The Bluetooth service is installed but not running"
msgstr "Bluetooth servisi kurulu ama çalışmıyor"

#: src/shell/corebridge.cpp:699 src/shell/corebridge.cpp:752
msgid "It starts when something needs it; to start it now, use the command"
msgstr ""
"Gerektiğinde kendiliğinden başlar; şimdi başlatmak için komutu kullanın"

#: src/shell/corebridge.cpp:702
msgid "The sandbox hides the Bluetooth service"
msgstr "Sandbox Bluetooth servisini gizliyor"

#: src/shell/corebridge.cpp:702
msgid "Allow the sandbox to talk to BlueZ, then restart KuickShare"
msgstr ""
"Sandbox’un BlueZ ile iletişim kurmasına izin verin, sonra KuickShare’i "
"yeniden başlatın"

#: src/shell/corebridge.cpp:706
msgid "No Bluetooth adapter was found"
msgstr "Bluetooth adaptörü bulunamadı"

#: src/shell/corebridge.cpp:706
msgid ""
"Plug in or enable a Bluetooth adapter; if one is installed, check that its "
"driver is loaded"
msgstr ""
"Bir Bluetooth adaptörü takın veya etkinleştirin; zaten takılıysa sürücüsünün "
"yüklendiğini kontrol edin"

#: src/shell/corebridge.cpp:710
msgid "The Bluetooth adapter is turned off"
msgstr "Bluetooth adaptörü kapalı"

#: src/shell/corebridge.cpp:710
msgid ""
"KuickShare turns it on when it needs it; you can also turn Bluetooth on in "
"the system settings"
msgstr ""
"KuickShare gerektiğinde onu açar; Bluetooth’u sistem ayarlarından da "
"açabilirsiniz"

#: src/shell/corebridge.cpp:713
msgid "Blocked by a radio switch"
msgstr "Bir radyo anahtarı tarafından engellendi"

#: src/shell/corebridge.cpp:713
msgid "Turn Bluetooth on in the system settings"
msgstr "Bluetooth’u sistem ayarlarından açın"

#: src/shell/corebridge.cpp:717
msgid "The Bluetooth adapter does not support Bluetooth Low Energy"
msgstr "Bluetooth adaptörü Bluetooth Low Energy desteklemiyor"

#: src/shell/corebridge.cpp:717
msgid "Use an adapter that supports Bluetooth 4.0 or newer"
msgstr "Bluetooth 4.0 veya daha yenisini destekleyen bir adaptör kullanın"

#: src/shell/corebridge.cpp:720
msgid "BlueZ does not report what the adapter can do"
msgstr "BlueZ, adaptörün neler yapabildiğini bildirmiyor"

#: src/shell/corebridge.cpp:720 src/shell/corebridge.cpp:734
msgid "This may still work; a newer BlueZ reports it"
msgstr "Yine de çalışabilir; daha yeni bir BlueZ bunu bildirir"

#: src/shell/corebridge.cpp:724
msgid "The Bluetooth adapter cannot advertise"
msgstr "Bluetooth adaptörü duyuru yapamıyor"

#: src/shell/corebridge.cpp:724
msgid ""
"Receiving by Bluetooth needs an adapter that can advertise; sending is not "
"affected"
msgstr ""
"Bluetooth ile almak duyuru yapabilen bir adaptör gerektirir; göndermeye "
"etkisi yoktur"

#: src/shell/corebridge.cpp:727
msgid "The adapter has no free advertising slot now"
msgstr "Adaptörde şu an boş duyuru yuvası yok"

#: src/shell/corebridge.cpp:727
msgid "Another program uses them; close it and refresh"
msgstr "Başka bir program bunları kullanıyor; onu kapatıp yenileyin"

#: src/shell/corebridge.cpp:731
msgid "The Bluetooth adapter cannot scan for devices"
msgstr "Bluetooth adaptörü cihazları tarayamıyor"

#: src/shell/corebridge.cpp:731
msgid "Sending needs an adapter that can scan; use another one"
msgstr "Göndermek, tarayabilen bir adaptör gerektirir; başka birini kullanın"

#: src/shell/corebridge.cpp:734
msgid "BlueZ does not report how the adapter can scan"
msgstr "BlueZ, adaptörün nasıl tarama yapabildiğini bildirmiyor"

#: src/shell/corebridge.cpp:738
msgid "BlueZ offers no GATT services"
msgstr "BlueZ GATT servisi sunmuyor"

#: src/shell/corebridge.cpp:738
msgid "Update BlueZ to a version with GATT support"
msgstr "BlueZ’u GATT desteği olan bir sürüme güncelleyin"

#: src/shell/corebridge.cpp:742
msgid "The sandbox does not allow Bluetooth sockets"
msgstr "Sandbox Bluetooth soketlerine izin vermiyor"

#: src/shell/corebridge.cpp:742
msgid ""
"Transfers still work over a slower path; allow Bluetooth for the Flatpak to "
"use the faster one"
msgstr ""
"Paylaşımlar hâlâ daha yavaş bir yoldan çalışır; daha hızlı olanı kullanmak "
"için Flatpak’ın Bluetooth’a erişmesine izin verin"

#: src/shell/corebridge.cpp:745
msgid "The kernel does not report Bluetooth socket support"
msgstr "Çekirdek Bluetooth soket desteğini bildirmiyor"

#: src/shell/corebridge.cpp:745
msgid "Transfers still work over a slower path if it is missing"
msgstr "Eksikse paylaşımlar yine de daha yavaş bir yoldan çalışır"

#: src/shell/corebridge.cpp:749
msgid "NetworkManager is not running"
msgstr "NetworkManager çalışmıyor"

#: src/shell/corebridge.cpp:749
msgid ""
"Wi-Fi Direct needs NetworkManager; start it, or install it if this computer "
"uses another network tool"
msgstr ""
"Wi-Fi Direct, NetworkManager gerektirir; onu başlatın ya da bu bilgisayar "
"başka bir ağ aracı kullanıyorsa kurun"

#: src/shell/corebridge.cpp:752
msgid "NetworkManager is installed but not running"
msgstr "NetworkManager kurulu ama çalışmıyor"

#: src/shell/corebridge.cpp:755
msgid "The sandbox hides NetworkManager"
msgstr "Sandbox NetworkManager’ı gizliyor"

#: src/shell/corebridge.cpp:755
msgid "Allow the sandbox to talk to NetworkManager, then restart KuickShare"
msgstr ""
"Sandbox’un NetworkManager ile iletişim kurmasına izin verin, sonra "
"KuickShare’i yeniden başlatın"

#: src/shell/corebridge.cpp:759
msgid "Networking is turned off in NetworkManager"
msgstr "NetworkManager’da ağ kapalı"

#: src/shell/corebridge.cpp:759
msgid "Turn networking on in the network settings"
msgstr "Ağı ağ ayarlarından açın"

#: src/shell/corebridge.cpp:763
msgid "Wi-Fi is turned off"
msgstr "Wi-Fi kapalı"

#: src/shell/corebridge.cpp:763
msgid "Turn Wi-Fi on in the system settings"
msgstr "Wi-Fi’yi sistem ayarlarından açın"

#: src/shell/corebridge.cpp:767
msgid "A hardware switch has turned the Wi-Fi radio off"
msgstr "Bir donanım anahtarı Wi-Fi radyosunu kapattı"

#: src/shell/corebridge.cpp:767
msgid "Use the Wi-Fi switch or key of this computer"
msgstr "Bu bilgisayardaki Wi-Fi anahtarını veya tuşunu kullanın"

#: src/shell/corebridge.cpp:771
msgid "There are several Wi-Fi adapters; the first one is used"
msgstr "Birden çok Wi-Fi adaptörü var; ilki kullanılıyor"

#: src/shell/corebridge.cpp:771
msgid "If transfers fail, turn off the adapters you do not need"
msgstr "Paylaşımlar başarısız olursa, ihtiyacınız olmayan adaptörleri kapatın"

#: src/shell/corebridge.cpp:774
msgid "No Wi-Fi adapter was found"
msgstr "Wi-Fi adaptörü bulunamadı"

#: src/shell/corebridge.cpp:774
msgid ""
"Plug in a Wi-Fi adapter, or check that the driver of the built-in one is "
"loaded"
msgstr ""
"Bir Wi-Fi adaptörü takın ya da yerleşik olanın sürücüsünün yüklendiğini "
"kontrol edin"

#: src/shell/corebridge.cpp:778
msgid "NetworkManager does not manage the Wi-Fi adapter"
msgstr "NetworkManager Wi-Fi adaptörünü yönetmiyor"

#: src/shell/corebridge.cpp:778
msgid ""
"Let NetworkManager manage it: another network tool or an unmanaged-devices "
"setting may be holding it"
msgstr ""
"NetworkManager’ın onu yönetmesine izin verin: başka bir ağ aracı ya da "
"yönetilmeyen cihazlar ayarı onu tutuyor olabilir"

#: src/shell/corebridge.cpp:782
msgid "The Wi-Fi adapter needs firmware that is not installed"
msgstr "Wi-Fi adaptörü, kurulu olmayan bir donanım yazılımına ihtiyaç duyuyor"

#: src/shell/corebridge.cpp:782
msgid ""
"Install the firmware package for the adapter (often linux-firmware), then "
"restart the computer"
msgstr ""
"Adaptör için donanım yazılımı paketini (çoğunlukla linux-firmware) kurun, "
"sonra bilgisayarı yeniden başlatın"

#: src/shell/corebridge.cpp:786
msgid "The NetworkManager plugin for the Wi-Fi adapter is missing"
msgstr "Wi-Fi adaptörü için NetworkManager eklentisi eksik"

#: src/shell/corebridge.cpp:786
msgid ""
"Install the NetworkManager Wi-Fi plugin package of your distribution, then "
"restart NetworkManager"
msgstr ""
"Dağıtımınızın NetworkManager Wi-Fi eklenti paketini kurun, sonra "
"NetworkManager’ı yeniden başlatın"

#: src/shell/corebridge.cpp:789
msgid "NetworkManager reports the Wi-Fi adapter as unavailable"
msgstr "NetworkManager, Wi-Fi adaptörünü kullanılamaz olarak bildiriyor"

#: src/shell/corebridge.cpp:789
msgid "Check that its driver loaded and its radio is on"
msgstr "Sürücüsünün yüklendiğini ve radyosunun açık olduğunu kontrol edin"

#: src/shell/corebridge.cpp:793
msgid "NetworkManager asks for authentication to control the network"
msgstr "NetworkManager, ağı denetlemek için kimlik doğrulaması istiyor"

#: src/shell/corebridge.cpp:793
msgid ""
"The hotspot may prompt for a password or be refused; allow network control "
"for your user in the PolicyKit settings"
msgstr ""
"Hotspot parola isteyebilir ya da reddedilebilir; PolicyKit ayarlarında "
"kullanıcınız için ağ denetimine izin verin"

#: src/shell/corebridge.cpp:796
msgid "NetworkManager does not allow this user to control the network"
msgstr "NetworkManager bu kullanıcının ağı denetlemesine izin vermiyor"

#: src/shell/corebridge.cpp:796
msgid ""
"Ask the administrator to allow network control and changes to system "
"connections for your user"
msgstr ""
"Yöneticiye, kullanıcınız için ağ denetimine ve sistem bağlantılarında "
"değişikliğe izin vermesini isteyin"

#: src/shell/corebridge.cpp:800
msgid "Joining Wi-Fi cannot work: something it needs is blocked"
msgstr "Wi-Fi ağına katılma çalışamaz: ihtiyaç duyduğu bir şey engellenmiş"

#: src/shell/corebridge.cpp:800
msgid "Fix the blocked items of NetworkManager and the Wi-Fi adapter"
msgstr "Engellenen NetworkManager ve Wi-Fi adaptörü öğelerini düzeltin"

#: src/shell/corebridge.cpp:803
msgid ""
"It is not known whether joining Wi-Fi works: something it needs could not be "
"checked"
msgstr ""
"Wi-Fi ağına katılmanın çalışıp çalışmadığı bilinmiyor: ihtiyaç duyduğu bir "
"şey kontrol edilemedi"

#: src/shell/corebridge.cpp:803
msgid "Refresh when the items above are sorted out"
msgstr "Yukarıdaki öğeler düzeltildiğinde yenileyin"

#: src/shell/corebridge.cpp:806 src/shell/corebridge.cpp:828
msgid "The sandbox has no network access"
msgstr "Sandbox’un ağ erişimi yok"

#: src/shell/corebridge.cpp:806 src/shell/corebridge.cpp:828
msgid "Allow the network for the Flatpak"
msgstr "Flatpak için ağa erişime izin verin"

#: src/shell/corebridge.cpp:810
msgid "The Wi-Fi adapter cannot create a hotspot"
msgstr "Wi-Fi adaptörü bir hotspot oluşturamıyor"

#: src/shell/corebridge.cpp:810
msgid ""
"Receiving by Wi-Fi needs an adapter with access point mode; Bluetooth still "
"works"
msgstr ""
"Wi-Fi ile almak erişim noktası modunu destekleyen bir adaptör gerektirir; "
"Bluetooth yine de çalışır"

#: src/shell/corebridge.cpp:813
msgid "The Wi-Fi adapter cannot protect a hotspot with WPA2"
msgstr "Wi-Fi adaptörü hotspot’u WPA2 ile koruyamıyor"

#: src/shell/corebridge.cpp:813
msgid "Receiving by Wi-Fi needs WPA2 on the adapter; Bluetooth still works"
msgstr "Wi-Fi ile almak adaptörde WPA2 gerektirir; Bluetooth yine de çalışır"

#: src/shell/corebridge.cpp:816
msgid "The Wi-Fi adapter reports no 2.4 GHz or 5 GHz band for a hotspot"
msgstr "Wi-Fi adaptörü hotspot için 2,4 GHz veya 5 GHz bandı bildirmiyor"

#: src/shell/corebridge.cpp:816
msgid "Receiving by Wi-Fi needs one of them; Bluetooth still works"
msgstr "Wi-Fi ile almak bunlardan birini gerektirir; Bluetooth yine de çalışır"

#: src/shell/corebridge.cpp:819
msgid "The Wi-Fi driver does not report what the adapter can do"
msgstr "Wi-Fi sürücüsü, adaptörün neler yapabildiğini bildirmiyor"

#: src/shell/corebridge.cpp:819
msgid "The hotspot may still work; it could not be checked"
msgstr "Hotspot yine de çalışabilir; kontrol edilemedi"

#: src/shell/corebridge.cpp:822
msgid "NetworkManager asks for authentication to share a connection"
msgstr ""
"NetworkManager, bir bağlantıyı paylaşmak için kimlik doğrulaması istiyor"

#: src/shell/corebridge.cpp:822
msgid ""
"The hotspot may prompt for a password or be refused; allow it in the "
"PolicyKit settings"
msgstr ""
"Hotspot parola isteyebilir ya da reddedilebilir; PolicyKit ayarlarında buna "
"izin verin"

#: src/shell/corebridge.cpp:825
msgid "This user may not share a connection"
msgstr "Bu kullanıcı bir bağlantıyı paylaşamaz"

#: src/shell/corebridge.cpp:825
msgid "Ask the administrator to allow sharing connections in NetworkManager"
msgstr ""
"Yöneticiye NetworkManager’da bağlantı paylaşımına izin vermesini isteyin"

#: src/shell/corebridge.cpp:832
msgid "dnsmasq is installed"
msgstr "dnsmasq kurulu"

#: src/shell/corebridge.cpp:835
msgid "The hotspot already handed out addresses in this session"
msgstr "Hotspot bu oturumda zaten adres dağıttı"

#: src/shell/corebridge.cpp:838
msgid "dnsmasq was not found"
msgstr "dnsmasq bulunamadı"

#: src/shell/corebridge.cpp:838
msgid ""
"The hotspot hands out addresses with dnsmasq; install the dnsmasq or dnsmasq-"
"base package"
msgstr ""
"Hotspot adreslerini dnsmasq ile dağıtır; dnsmasq veya dnsmasq-base paketini "
"kurun"

#: src/shell/corebridge.cpp:841
msgid "Checked when the first hotspot starts"
msgstr "İlk hotspot başladığında kontrol edilir"

#: src/shell/corebridge.cpp:841
msgid "The sandbox cannot look for dnsmasq on this computer"
msgstr "Sandbox bu bilgisayarda dnsmasq’ı arayamıyor"

#: src/shell/corebridge.cpp:844
msgid "The hotspot could not start its address service"
msgstr "Hotspot adres servisini başlatamadı"

#: src/shell/corebridge.cpp:844
msgid "Install the dnsmasq or dnsmasq-base package"
msgstr "dnsmasq veya dnsmasq-base paketini kurun"

#: src/shell/corebridge.cpp:848
msgid "The firewall service (firewalld) is not running"
msgstr "Güvenlik duvarı servisi (firewalld) çalışmıyor"

#: src/shell/corebridge.cpp:848
msgid ""
"KuickShare cannot open the hotspot port by itself; it asks you before the "
"hotspot uses an open zone"
msgstr ""
"KuickShare hotspot bağlantı noktasını kendi başına açamaz; hotspot açık bir "
"bölge kullanmadan önce size sorar"

#: src/shell/corebridge.cpp:851
msgid "The sandbox hides the firewall service"
msgstr "Sandbox güvenlik duvarı servisini gizliyor"

#: src/shell/corebridge.cpp:851
msgid "Allow the sandbox to talk to firewalld, then restart KuickShare"
msgstr ""
"Sandbox’un firewalld ile iletişim kurmasına izin verin, sonra KuickShare’i "
"yeniden başlatın"

#: src/shell/corebridge.cpp:854
msgid "The firewall has no zone for the hotspot (nm-shared)"
msgstr "Güvenlik duvarında hotspot için bir bölge yok (nm-shared)"

#: src/shell/corebridge.cpp:854
msgid "The hotspot may be blocked or open; add the zone or check its rules"
msgstr ""
"Hotspot engellenmiş ya da açık olabilir; bölgeyi ekleyin veya kurallarını "
"kontrol edin"

#: src/shell/corebridge.cpp:857
msgid "Changing the firewall asks for authentication"
msgstr "Güvenlik duvarını değiştirmek kimlik doğrulaması istiyor"

#: src/shell/corebridge.cpp:857
msgid "Opening the hotspot port may prompt for a password or be refused"
msgstr ""
"Hotspot bağlantı noktasını açmak parola isteyebilir ya da reddedilebilir"

#: src/shell/corebridge.cpp:860
msgid "This user may not change the firewall"
msgstr "Bu kullanıcı güvenlik duvarını değiştiremez"

#: src/shell/corebridge.cpp:860
msgid "The hotspot port cannot be opened; ask the administrator to allow it"
msgstr ""
"Hotspot bağlantı noktası açılamıyor; yöneticiye buna izin vermesini isteyin"

#: src/shell/corebridge.cpp:863
msgid "It cannot be checked whether this user may change the firewall"
msgstr ""
"Bu kullanıcının güvenlik duvarını değiştirip değiştiremeyeceği kontrol "
"edilemiyor"

#: src/shell/corebridge.cpp:863
msgid "polkit could not be asked without a prompt; the hotspot is tried anyway"
msgstr ""
"polkit, kimlik doğrulaması istemeden sorulamadı; hotspot yine de denenir"

#: src/shell/corebridge.cpp:866
msgid "The firewall refused the hotspot in this session"
msgstr "Güvenlik duvarı bu oturumda hotspot’u reddetti"

#: src/shell/corebridge.cpp:866
msgid ""
"Allow the hotspot in the firewall, or let it use an open zone when asked"
msgstr ""
"Hotspot’a güvenlik duvarında izin verin ya da sorulduğunda açık bir bölge "
"kullanmasına izin verin"

#: src/shell/corebridge.cpp:869
msgid "You allowed the hotspot to use an open firewall zone in this session"
msgstr ""
"Bu oturumda hotspot’un açık bir güvenlik duvarı bölgesi kullanmasına izin "
"verdiniz"

#: src/shell/corebridge.cpp:869
msgid "Turning the setting off takes this back"
msgstr "Ayarı kapatmak bunu geri alır"

#: src/shell/corebridge.cpp:874
msgid "The Flatpak lacks permissions it needs"
msgstr "Flatpak’ın ihtiyaç duyduğu izinler eksik"

#: src/shell/corebridge.cpp:874
msgid "Allow them, then restart KuickShare"
msgstr "Bunlara izin verin, sonra KuickShare’i yeniden başlatın"

#: src/shell/corebridge.cpp:877
msgid "The Flatpak can see the whole file system"
msgstr "Flatpak tüm dosya sistemini görebiliyor"

#: src/shell/corebridge.cpp:877
msgid "It does not need to; take that permission away"
msgstr "Buna gerek yok; bu izni kaldırın"

#: src/shell/corebridge.cpp:881
msgid "No more information is available"
msgstr "Başka bilgi yok"

#: src/shell/corebridge.cpp:888 src/shell/qml/SendPage.qml:224
msgid "Ready"
msgstr "Hazır"

#: src/shell/corebridge.cpp:890
msgid "Warning"
msgstr "Uyarı"

#: src/shell/corebridge.cpp:892
msgid "Blocked"
msgstr "Engellendi"

#: src/shell/corebridge.cpp:894
msgid "Checking"
msgstr "Kontrol ediliyor"

#: src/shell/corebridge.cpp:898 src/shell/corebridge.cpp:930
msgid "Unknown"
msgstr "Bilinmiyor"

#: src/shell/corebridge.cpp:922
msgid "Available"
msgstr "Kullanılabilir"

#: src/shell/corebridge.cpp:924
msgid "Limited"
msgstr "Sınırlı"

#: src/shell/corebridge.cpp:926
msgid "Unavailable"
msgstr "Kullanılamıyor"

#: src/shell/corebridge.cpp:1223
